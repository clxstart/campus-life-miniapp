{
  "description": "校园生活微信小程序首页",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "docs"
      },
      {
        "type": "folder",
        "value": "backend"
      },
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "web"
      }
    ]
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "coverView": true,
    "showShadowRootInWxmlPanel": true,
    "useCompilerPlugins": false,
    "minifyWXML": true,
    "packNpmManually": true,
    "packNpmRelationList": [
      {
        "packageJsonPath": "./package.json",
        "miniprogramNpmDistDir": "./"
      }
    ]
  },
  "compileType": "miniprogram",
  "libVersion": "3.5.8",
  "appid": "touristappid",
  "projectname": "campus-life-miniapp",
  "condition": {}
}