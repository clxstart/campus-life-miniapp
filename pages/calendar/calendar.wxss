.cal-page{min-height:100vh;background:#f6f8fb;box-sizing:border-box;padding-bottom:60rpx}
.nav{box-sizing:content-box;display:flex;align-items:center;padding:0 32rpx;background:#f6f8fb
  box-shadow: 0 2rpx 0 #eef1f4; /* 白导航压在浅底上，加分隔线否则边界看不清 */
}
.nav-title{font-size:36rpx;font-weight:700}
.back{flex:none;margin-right:20rpx;padding:0 10rpx;font-size:40rpx;font-weight:400;color:#1a2330}

/* 学期总览卡：渐变底 + 进度条 */
.cal-hero{margin:14rpx 32rpx 0;padding:28rpx 28rpx 24rpx;border-radius:24rpx;background:linear-gradient(135deg,#d8ebff 0%,#e8f8f1 58%,#fff0f5 100%);box-shadow:0 8rpx 24rpx rgba(80,125,175,.09)}
.cal-term{display:block;font-size:19rpx;font-weight:600;color:#4d76a0;letter-spacing:2rpx}
.cal-week{display:block;margin-top:10rpx;font-size:31rpx;line-height:42rpx;font-weight:700;color:#15334e}
.cal-bar{margin-top:20rpx;height:12rpx;border-radius:6rpx;background:rgba(255,255,255,.75);overflow:hidden}
.cal-bar-inner{height:100%;border-radius:6rpx;background:linear-gradient(90deg,#69adff,#62c78e)}
.cal-bar-meta{margin-top:10rpx;display:flex;justify-content:space-between;font-size:16rpx;color:#5c7c96}

/* 时间线列表 */
.cal-list{margin:24rpx 32rpx 0}
.cal-item{display:flex}
.cal-rail{flex:none;width:26rpx;display:flex;flex-direction:column;align-items:center}
.cal-dot{flex:none;width:16rpx;height:16rpx;margin-top:34rpx;border-radius:50%;background:#c9d4de}
.cal-dot.ongoing{background:#3476f6;box-shadow:0 0 0 6rpx rgba(52,118,246,.16)}
.cal-dot.past{background:#b9c6d2}
.cal-line{flex:1;width:2rpx;margin-top:6rpx;background:#dde5ec}
.cal-card{flex:1;min-width:0;margin:0 0 18rpx 14rpx;padding:22rpx 24rpx;border-radius:20rpx;background:#fff;box-shadow:0 5rpx 18rpx rgba(46,65,86,.045)}
.cal-item:last-child .cal-card{margin-bottom:0}
.cal-card-top{display:flex;align-items:center;justify-content:space-between}
.cal-title{font-size:25rpx;font-weight:700;color:#1a2330}
.cal-chip{flex:none;padding:4rpx 14rpx;border-radius:18rpx;font-size:15rpx}
.cal-chip.ongoing{background:#e3edff;color:#2f6fd8;font-weight:600}
.cal-chip.past{background:#f0f3f6;color:#98a2ac}
.cal-chip.upcoming{background:#e2f7ea;color:#2f9e68}
.cal-date{display:block;margin-top:10rpx;font-size:19rpx;color:#688092}
.cal-note{display:block;margin-top:6rpx;font-size:18rpx;line-height:26rpx;color:#98a2ac}

.cal-state{padding:50rpx 24rpx;text-align:center;font-size:26rpx;color:#99a3ad}
