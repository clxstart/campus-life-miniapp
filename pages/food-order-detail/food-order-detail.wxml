<view class="detail-page">
  <view class="nav" style="padding-top:{{statusBarHeight}}px;height:{{navBarHeight}}px;padding-right:{{capsuleReservedRight}}px"><view class="back" catchtap="goBack">‹</view><view class="nav-title">订单详情</view><view class="nav-action">每 3 秒更新</view></view>
  <offline-banner />
  <view wx:if="{{loading}}" class="state">正在加载订单…</view>
  <view wx:elif="{{error}}" class="state"><text class="state-title">{{error}}</text><view bindtap="goBack">返回订单列表</view></view>
  <block wx:elif="{{order}}">
    <view class="status-panel"><text class="status-mark">●</text><text class="status-title">{{order.statusText}}</text><text class="status-note">订单号 #{{order.id}}</text><text class="status-note">{{order.createdText}}</text></view>
    <view class="detail-card"><text class="shop-name">{{order.shopName}}</text><view wx:for="{{order.items}}" wx:key="goodsId" class="item-row"><text>{{item.name}} × {{item.count}}</text><text>¥{{item.lineTotal}}</text></view><view class="total-row"><text>实付款</text><text class="total">¥{{order.totalText}}</text></view></view>
    <view class="detail-card address-card"><text class="label">配送地址</text><text>{{order.address}}</text><text wx:if="{{order.remark}}" class="remark">备注：{{order.remark}}</text></view>
  </block>
</view>
