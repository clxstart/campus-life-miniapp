@import '../../utils/food.wxss';
.track-page{min-height:100vh;padding-bottom:60rpx;background:#F7F9FC}
.track-nav{display:flex;align-items:center;height:92rpx;padding:0 28rpx;color:#1A2330;font-size:30rpx;font-weight:700}
.track-nav .back{width:68rpx;font-size:54rpx;font-weight:400}
.nav-action{margin-left:auto;color:#249B70;font-size:23rpx;font-weight:500}
.track-state{padding:100rpx 32rpx;text-align:center;color:#718078;font-size:26rpx}
.error{display:block;color:#C95F50;margin-bottom:20rpx}
.refresh{color:#249B70}
.status-block{display:flex;flex-direction:column;align-items:center;padding:44rpx 28rpx 40rpx;background:#EAF6EE}
.status-mark{display:grid;place-items:center;width:72rpx;height:72rpx;border-radius:50%;background:#249B70;color:#fff;font-size:40rpx}
.status-title{margin-top:18rpx;color:#193D32;font-size:34rpx;font-weight:700}
.status-hint{margin-top:8rpx;color:#5F8972;font-size:23rpx;text-align:center}
.section{margin:22rpx 24rpx 0;padding:28rpx;background:#fff;border-radius:18rpx}
.section-title{display:block;margin-bottom:20rpx;color:#1A2330;font-size:27rpx;font-weight:700}
.info-row,.fee-row{display:flex;justify-content:space-between;gap:24rpx;padding:13rpx 0;font-size:23rpx}
.label{flex:none;color:#8A9690}
.value{color:#2B3540;text-align:right;word-break:break-word}
.rider-row{display:flex;align-items:center;justify-content:space-between;margin-top:8rpx;padding:18rpx 0 0;border-top:1rpx solid #EEF2EF}
.rider-name{margin-left:18rpx;color:#1A2330;font-size:24rpx;font-weight:600}
.items{display:block;color:#45534D;font-size:24rpx;line-height:1.7}
.fee-row{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #EEF2EF;color:#65736B}
.offline-note{margin:24rpx;text-align:center;color:#98A2AC;font-size:21rpx}
/* F10：订单完成发分提示条。用页面既有的绿色系（#249B70 / #EAF6EE），与下方状态块同一套色 */
.points-banner{display:flex;align-items:center;margin:18rpx 24rpx 0;padding:20rpx 22rpx;border-radius:16rpx;background:#EAF6EE;border:1rpx solid #CDE7D8}
.points-banner-mark{flex:none;width:38rpx;height:38rpx;border-radius:50%;background:#249B70;color:#fff;font-size:26rpx;font-weight:700;line-height:38rpx;text-align:center}
.points-banner-text{flex:1;min-width:0;margin-left:14rpx;color:#193D32;font-size:25rpx;line-height:36rpx;font-weight:600}
.points-banner-close{flex:none;width:44rpx;height:44rpx;line-height:40rpx;text-align:center;color:#7BA48F;font-size:32rpx}
/* F10：订单完成发分提示条（成功色，与页面既有的绿色状态块同一套色） */
