@import "../../styles/theme.wxss";
@import "../../styles/common.wxss";

/* 创建圈子：表单页，卡片一律 .cp-card 叠放，这里只补页面级布局与表单控件 */
.circle-create-page {
  padding-bottom: calc(48rpx + var(--safe-bottom));
}

.create-body {
  padding-bottom: 24rpx;
}

.create-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 0 24rpx;
}

/* ===== 页面级失败 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 24rpx;
  text-align: center;
}

.state-title {
  font-size: var(--fs-card-title);
  font-weight: 600;
  color: var(--c-text);
}

.state-btn {
  min-width: 280rpx;
  margin-top: 8rpx;
}

/* ===== 无权限说明卡 ===== */
.notice-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gate-btn {
  margin-top: 8rpx;
}

/* ===== 表单 ===== */
.form-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.field-block {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.field-label {
  font-size: var(--fs-hint);
  color: var(--c-text-sub);
  line-height: 1.6;
}

.field-count {
  font-size: var(--fs-hint);
  color: var(--c-text-sub);
  line-height: 1.6;
}

.field-input,
.field-picker {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  border-radius: var(--radius-pill);
  font-size: var(--fs-body);
  color: var(--c-text);
  box-sizing: border-box;
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.field-picker-text {
  font-size: var(--fs-body);
  color: var(--c-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-picker-text--empty {
  color: var(--c-text-sub);
}

.field-picker-arrow {
  color: var(--c-text-sub);
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
}

.field-textarea {
  width: 100%;
  height: 176rpx;
  padding: 20rpx 24rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  border-radius: 20rpx;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--c-text);
  box-sizing: border-box;
}

.field-placeholder {
  color: var(--c-text-sub);
}

.field-error {
  font-size: var(--fs-hint);
  color: var(--c-accent);
  line-height: 1.5;
}

/* ===== 封面：可选，上传前只显示本地预览 ===== */
.cover-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cover-preview {
  position: relative;
  flex: none;
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--c-line);
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: var(--radius-pill);
  text-align: center;
  font-size: 28rpx;
  color: var(--c-on-primary);
  background: rgba(32, 61, 52, 0.6);
}

.cover-add {
  flex: none;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 1rpx dashed var(--c-line);
  border-radius: 20rpx;
  background: var(--c-soft);
}

.cover-plus {
  font-size: 36rpx;
  line-height: 1.2;
  color: var(--c-primary);
}

.cover-add-text {
  font-size: var(--fs-hint);
  color: var(--c-text-sub);
}

.cover-note {
  font-size: var(--fs-hint);
  color: var(--c-text-sub);
  line-height: 1.5;
  flex: 1;
  min-width: 0;
}

/* ===== 说明卡 / 提交 ===== */
.tips-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.submit-btn {
  margin-top: var(--sp-gap);
}

.offline-hint {
  display: block;
  margin-top: 12rpx;
  text-align: center;
}