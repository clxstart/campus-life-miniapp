/* 咨询二维码页：一张卡片居中，重点是二维码本身够大够清楚 */
.qr-page {
  min-height: 100vh;
  background: #F7F3EA;
  padding: 0 40rpx 80rpx;
  box-sizing: border-box;
}

.qr-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  position: relative;
}
.qr-back {
  font-size: 48rpx;
  line-height: 1;
  color: #203D34;
  width: 60rpx;
}
.qr-nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #203D34;
  pointer-events: none;
}

.qr-state {
  padding: 140rpx 0;
  text-align: center;
  color: #586A60;
  font-size: 28rpx;
}

.qr-card {
  margin-top: 16rpx;
  background: #FFFCF5;
  border: 1rpx solid #DEDCCD;
  border-radius: 32rpx;
  padding: 44rpx 36rpx 36rpx;
  text-align: center;
  box-sizing: border-box;
}

.qr-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #203D34;
  margin-bottom: 32rpx;
}

/* 二维码容器：白底 + 内边距，扫码更容易对准 */
.qr-image-wrap {
  width: 440rpx;
  height: 440rpx;
  margin: 0 auto;
  background: #FFFFFF;
  border: 1rpx solid #DEDCCD;
  border-radius: 20rpx;
  padding: 16rpx;
  box-sizing: border-box;
}
.qr-image {
  width: 100%;
  height: 100%;
}

.qr-tip-main {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #203D34;
  font-weight: 500;
}
.qr-tip-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8A9992;
  line-height: 1.6;
}

/* 未配置时的说明块 */
.qr-empty {
  padding: 40rpx 20rpx 32rpx;
}
.qr-empty-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}
.qr-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #203D34;
  margin-bottom: 12rpx;
}
.qr-empty-text {
  font-size: 24rpx;
  color: #586A60;
  line-height: 1.7;
}

/* 微信号 + 一键复制 */
.qr-wechat {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #EFEDE4;
}
.qr-wechat-label {
  font-size: 24rpx;
  color: #8A9992;
  margin-bottom: 12rpx;
}
.qr-wechat-value {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 28rpx;
  background: #F2F6EF;
  border-radius: 999rpx;
}
.qr-wechat-id {
  font-size: 28rpx;
  color: #203D34;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
.qr-wechat-copy {
  font-size: 23rpx;
  color: #2F6555;
}

.qr-hint {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #586A60;
  line-height: 1.7;
  text-align: left;
  background: #FBF6EC;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.qr-footnote {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8A9992;
}
