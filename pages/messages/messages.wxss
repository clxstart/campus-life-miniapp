.messages-page {
  min-height: 100vh;
  background: #f7f9fc;
}

.messages-navbar {
  background: rgba(247, 249, 252, 0.98);
}

.messages-navbar-row {
  padding-left: 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.messages-title {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: #111820;
}

.read-all {
  padding: 12rpx 0 12rpx 20rpx;
  font-size: 17rpx;
  color: #6c96cf;
}

.messages-content {
  padding: 17rpx 32rpx calc(125rpx + env(safe-area-inset-bottom));
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13rpx;
}

.quick-card {
  position: relative;
  height: 153rpx;
  padding: 15rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 18rpx rgba(46, 65, 86, 0.055);
}

.quick-icon {
  width: 45rpx;
  height: 45rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 45rpx;
  font-weight: 600;
}

.heart-icon {
  background: linear-gradient(145deg, #ff91a2, #ff6479);
}

.reply-icon {
  background: linear-gradient(145deg, #72b9ff, #448cf2);
  font-size: 18rpx;
}

.notice-icon {
  background: linear-gradient(145deg, #7bd3a1, #50b97f);
}

.quick-name,
.quick-desc {
  display: block;
}

.quick-name {
  margin-top: 11rpx;
  font-size: 18rpx;
  line-height: 25rpx;
  font-weight: 600;
  color: #17212b;
}

.quick-desc {
  margin-top: 2rpx;
  font-size: 13rpx;
  line-height: 19rpx;
  color: #9ba2a9;
}

.quick-dot,
.quick-badge {
  position: absolute;
  right: 14rpx;
  top: 15rpx;
  background: #ff5c64;
}

.quick-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
}

.quick-badge {
  min-width: 23rpx;
  height: 23rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 13rpx;
  line-height: 23rpx;
  text-align: center;
}

.message-tabs {
  height: 76rpx;
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 42rpx;
  border-bottom: 1rpx solid #e8edf2;
}

.message-tab {
  position: relative;
  height: 76rpx;
  padding-top: 23rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #8b939a;
}

.message-tab.selected {
  color: #17212b;
  font-weight: 600;
}

.message-tab.selected::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 3rpx;
  width: 25rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: #3476f6;
  transform: translateX(-50%);
}

.conversation-list,
.notice-list {
  overflow: hidden;
  border-radius: 21rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 18rpx rgba(46, 65, 86, 0.045);
}

.conversation-list {
  margin-top: 17rpx;
}

.conversation-item {
  height: 103rpx;
  padding: 17rpx 18rpx;
  display: flex;
  align-items: center;
}

.conversation-item + .conversation-item {
  border-top: 1rpx solid #eef1f4;
}

.conversation-avatar {
  position: relative;
  flex: none;
  width: 62rpx;
  height: 62rpx;
  border-radius: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
}

.online-dot {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  background: #5dca8a;
}

.conversation-copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.conversation-top,
.conversation-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.conversation-name {
  font-size: 20rpx;
  line-height: 27rpx;
  font-weight: 600;
  color: #17212b;
}

.conversation-time {
  font-size: 14rpx;
  color: #a3a9af;
}

.conversation-bottom {
  margin-top: 6rpx;
}

.conversation-preview {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 16rpx;
  color: #868e95;
}

.conversation-unread {
  flex: none;
  min-width: 23rpx;
  height: 23rpx;
  margin-left: 12rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  background: #ff5c64;
  color: #ffffff;
  font-size: 13rpx;
  line-height: 23rpx;
  text-align: center;
}

.notice-list {
  margin-top: 17rpx;
}

.notice-item {
  min-height: 118rpx;
  padding: 18rpx;
  display: flex;
}

.notice-item + .notice-item {
  border-top: 1rpx solid #eef1f4;
}

.notice-symbol {
  flex: none;
  width: 49rpx;
  height: 49rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}

.notice-symbol.green { background: #62c892; }
.notice-symbol.blue { background: #5a9ff2; }
.notice-symbol.yellow { background: #f3ba50; }

.notice-copy {
  margin-left: 13rpx;
  display: flex;
  flex-direction: column;
}

.notice-title {
  font-size: 19rpx;
  line-height: 26rpx;
  font-weight: 600;
  color: #17212b;
}

.notice-content {
  margin-top: 4rpx;
  font-size: 16rpx;
  line-height: 24rpx;
  color: #6f7880;
}

.notice-time {
  margin-top: 6rpx;
  font-size: 13rpx;
  color: #a1a8ae;
}

.message-state{padding:44rpx 24rpx;color:#99a3ad;text-align:center;font-size:25rpx}
