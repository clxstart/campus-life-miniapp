<view class="ag-page">
  <view class="ag-nav">
    <view hover-class="tap" hover-stay-time="80" class="ag-back" catchtap="goBack">‹</view>
    <view class="ag-nav-title">{{title}}</view>
  </view>

  <view class="ag-header">
    <view class="ag-title">{{title}}</view>
    <view class="ag-meta">更新日期：{{updatedAt}}</view>
    <view wx:if="{{schoolName}}" class="ag-meta">适用：{{schoolName}}</view>
  </view>

  <view class="ag-body">
    <view wx:for="{{sections}}" wx:key="heading" class="ag-section">
      <view class="ag-heading">{{item.heading}}</view>
      <view wx:for="{{item.items}}" wx:for-item="line" wx:key="*this" class="ag-line">{{line}}</view>
    </view>
  </view>

  <view class="ag-footer">
    <view hover-class="tap" hover-stay-time="80" class="ag-switch" catchtap="switchDoc">
      {{type === 'privacy' ? '查看《用户协议》' : '查看《隐私政策》'}}
    </view>
    <view class="ag-tip">继续使用本服务即表示你已阅读并同意上述内容</view>
  </view>
</view>
