@import '../../utils/food.wxss';
.hero{position:relative;margin:18rpx 28rpx 24rpx;height:280rpx;overflow:hidden;background:#E4F1DF}
.hero-image{width:100%;height:100%}
.hero-copy{position:absolute;left:28rpx;top:30rpx}
.eyebrow{display:block;font-size:20rpx;letter-spacing:2rpx;color:#4E785C}
.hero-title{display:block;white-space:pre-line;margin-top:12rpx;font-size:40rpx;line-height:1.3;color:#193D32;font-weight:800}
.hero-note{display:block;margin-top:16rpx;font-size:20rpx;color:#557B60}
.search-box{display:flex;align-items:center;margin:0 28rpx 22rpx;padding:0 24rpx;height:88rpx}
.search-mark{margin-right:14rpx;color:#249B70;font-size:40rpx}
.search-input{flex:1;height:64rpx;font-size:25rpx;min-width:0}
.search-placeholder{color:#98A2AC}
.search-clear{padding:8rpx 12rpx;color:#98A2AC;font-size:34rpx}
.section-heading{display:flex;align-items:center;justify-content:space-between;margin:26rpx 30rpx 20rpx;font-size:30rpx}
.shop-list{padding:0 28rpx}
.shop-card{position:relative;display:flex;gap:22rpx;margin-bottom:20rpx;padding:22rpx}
.shop-cover{width:160rpx;height:160rpx;flex:none;border-radius:16rpx;background:#EDF5EF}
.shop-info{flex:1;min-width:0}
.shop-title{font-size:29rpx;line-height:40rpx;padding-right:10rpx}
.shop-rating{margin-top:8rpx;font-size:21rpx}
.star{color:#D99946;font-weight:700}
.sales{margin-left:18rpx;color:#98A2AC}
.shop-fees{margin-top:10rpx;color:#98A2AC;font-size:21rpx}
.fee-gap{margin-left:18rpx}
.shop-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx}
.eta{padding:5rpx 10rpx;background:#EDF4FF;border-radius:9rpx;color:#3476F6;font-size:19rpx}
.shop-arrow{position:absolute;top:24rpx;right:18rpx;color:#C1CEC7;font-size:32rpx}
.list-footer{text-align:center;padding:24rpx 0;color:#98A2AC;font-size:21rpx}

/* 本校/全部切换：分段控件 */
.scope-switch{display:flex;margin-left:auto;margin-right:16rpx;padding:4rpx;border-radius:22rpx;background:#f0f2f4}
.scope-opt{padding:8rpx 20rpx;border-radius:18rpx;color:#737e88;font-size:21rpx}
.scope-opt.on{background:#fff;color:#3476f6;font-weight:600;box-shadow:0 2rpx 6rpx rgba(36,62,96,.08)}
