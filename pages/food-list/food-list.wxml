<view class="food-page">
<view class="nav" style="padding-top:{{statusBarHeight}}px;height:{{navBarHeight}}px;padding-right:{{capsuleReservedRight}}px"><view class="back" catchtap="goBack">‹</view><view class="nav-title">校园外卖</view><!-- 本校/全部：外卖按校隔离 --><view class="scope-switch"><view class="scope-opt {{schoolScope==='local'?'on':''}}" data-scope="local" catchtap="switchSchoolScope">本校</view><view class="scope-opt {{schoolScope==='all'?'on':''}}" data-scope="all" catchtap="switchSchoolScope">全部</view></view></view>
  <offline-banner />
  <view class="hero card"><image class="hero-image" src="/assets/home/food-fresh.webp" mode="aspectFill"/><view class="hero-copy"><text class="eyebrow">下课后的好食光</text><text class="hero-title">好好吃饭
也好好生活</text><text class="hero-note">校园好味 · 送到楼下</text></view></view>
  <view class="search-box card"><text class="search-mark">⌕</text><input class="search-input" value="{{keyword}}" placeholder="今天想吃哪一家？" placeholder-class="search-placeholder" bindinput="search" confirm-type="search" maxlength="40"/><view wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">×</view></view>
  <scroll-view class="chips" scroll-x enhanced show-scrollbar="{{false}}"><view class="chip-row"><view wx:for="{{categories}}" wx:key="*this" class="chip {{category===item?'active':''}}" data-category="{{item}}" bindtap="chooseCategory">{{item}}</view></view></scroll-view>
  <view class="section-heading"><text class="title">校园附近</text><text class="muted">{{loading?'正在寻找好味道':shops.length+'家店铺'}}</text></view>
  <view wx:if="{{loading}}" class="state">正在准备校园菜单…</view>
  <view wx:elif="{{!shops.length}}" class="state"><text class="state-title">暂时没有找到这家店</text>试试其他分类或店名</view>
  <view wx:else class="shop-list"><view wx:for="{{shops}}" wx:key="id" class="shop-card card {{item.isOpen?'':'shop-closed'}}" data-id="{{item.id}}" bindtap="openShop"><image class="shop-cover" src="{{item.cover}}" mode="aspectFill"/><view class="shop-info"><view class="shop-title title">{{item.name}}</view><view class="shop-rating"><text class="star">★ {{item.ratingText}}</text><text class="sales">月售 {{item.monthlySales}}</text></view><view class="shop-fees">起送¥{{item.minPriceText}}<text class="fee-gap">配送¥{{item.deliveryFeeText}}</text></view><view class="shop-tags"><text wx:if="{{item.isOpen}}" class="eta">{{item.deliveryTime}}分钟送达</text><text wx:else class="rest-badge">休息中</text><text wx:if="{{item.discount}}" class="discount-pill">{{item.discount}}</text></view></view><text class="shop-arrow">›</text></view></view>
  <view class="list-footer">吃一顿喜欢的，给今天充点电</view>
<ui-popup id="ui-popup" visible="{{uiPopup.visible}}" mode="{{uiPopup.mode}}" tone="{{uiPopup.tone}}" title="{{uiPopup.title}}" message="{{uiPopup.message}}" editable="{{uiPopup.editable}}" placeholder="{{uiPopup.placeholder}}" inputValue="{{uiPopup.inputValue}}" actions="{{uiPopup.actions}}" show-cancel="{{uiPopup.showCancel}}" confirm-text="{{uiPopup.confirmText}}" bindconfirm="onPopupConfirm" bindcancel="onPopupCancel" bindaction="onPopupAction" bindinput="onPopupInput" bindclose="onPopupClose"/>
</view>
<!-- 全局悬浮宠物 -->
<pet-float bottom="200" />
