/* 活动报名页：沿用项目暖色手账风格 */
.ae-page {
  min-height: 100vh;
  background: #F7F3EA;
  padding: 0 32rpx 60rpx;
  box-sizing: border-box;
}

.ae-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  position: relative;
}
.ae-back {
  font-size: 48rpx;
  line-height: 1;
  color: #203D34;
  width: 60rpx;
}
.ae-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #203D34;
  pointer-events: none;
}

.ae-state {
  padding: 120rpx 0;
  text-align: center;
  color: #586A60;
  font-size: 28rpx;
}

.ae-card {
  background: #FFFCF5;
  border: 1rpx solid #DEDCCD;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* 活动信息 */
.ae-activity {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}
.ae-poster {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #E0EADC;
}
.ae-activity-meta { flex: 1; min-width: 0; }
.ae-activity-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #203D34;
  line-height: 1.4;
}
.ae-activity-sub {
  font-size: 24rpx;
  color: #586A60;
  margin-top: 8rpx;
}
.ae-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #BD5134;
  line-height: 1.5;
  background: #FBF0EC;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
}

/* 表单 */
.ae-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #203D34;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.ae-count {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 400;
  color: #586A60;
}
.ae-req { color: #BD5134; }

.ae-field { margin-bottom: 24rpx; }
.ae-field:last-child { margin-bottom: 0; }
.ae-label {
  font-size: 26rpx;
  color: #586A60;
  margin-bottom: 10rpx;
}
.ae-input,
.ae-textarea {
  width: 100%;
  background: #F7F3EA;
  border: 1rpx solid #DEDCCD;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #203D34;
  box-sizing: border-box;
}
.ae-textarea {
  height: 160rpx;
  line-height: 1.5;
}

/* 材料 */
.ae-material-tip {
  font-size: 24rpx;
  color: #586A60;
  margin-bottom: 18rpx;
}
.ae-materials {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.ae-material {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #E0EADC;
}
.ae-material-img { width: 100%; height: 100%; }
.ae-material-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(32, 61, 52, 0.72);
  color: #FFFCF5;
  font-size: 30rpx;
  border-bottom-left-radius: 16rpx;
}
.ae-material-add {
  width: 160rpx;
  height: 160rpx;
  border: 1rpx dashed #C9C6B4;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F7F3EA;
}
.ae-plus {
  font-size: 44rpx;
  color: #8A9992;
  line-height: 1;
}
.ae-add-text {
  font-size: 22rpx;
  color: #8A9992;
  margin-top: 8rpx;
}

/* 按钮 */
.ae-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  margin-top: 8rpx;
}
.ae-btn::after { border: 0; }
.ae-btn-primary {
  background: #2F6555;
  color: #FFFCF5;
}
.ae-btn-ghost {
  background: transparent;
  color: #2F6555;
  border: 1rpx solid #2F6555;
}
.ae-btn-disabled { opacity: 0.45; }
.ae-footnote {
  text-align: center;
  font-size: 22rpx;
  color: #8A9992;
  margin-top: 18rpx;
}

/* 已提交 */
.ae-done { text-align: center; padding: 56rpx 28rpx; }
.ae-done-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 50%;
  background: #E0EADC;
  color: #2F6555;
  font-size: 48rpx;
  margin: 0 auto 24rpx;
}
.ae-done-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #203D34;
}
.ae-done-text {
  font-size: 26rpx;
  color: #586A60;
  line-height: 1.6;
  margin: 16rpx 0 32rpx;
}
