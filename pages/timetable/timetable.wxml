<view class="tt-page">
  <!-- 自定义导航：与帖子详情页同款 -->
  <view class="nav" style="padding-top:{{statusBarHeight}}px">
    <view class="back" catchtap="goBack">‹</view>
    <view class="nav-title">课表</view>
    <view class="tt-edit-hint">可编辑</view>
  </view>
  <offline-banner local="{{offline}}" />

  <view wx:if="{{loading}}" class="tt-tip">正在加载课表…</view>
  <view wx:if="{{error}}" class="tt-tip" bindtap="loadTimetable">{{error}} · 点击重试</view>

  <block wx:if="{{!loading && !error}}">
    <!-- 学期 + 周次切换：调休课只在对应周出现 -->
    <view class="tt-head">
      <text class="tt-term">{{termLabel}}</text>
      <view class="tt-week-switch">
        <view class="tt-week-btn" catchtap="switchWeek" data-week="{{week - 1}}">‹</view>
        <text class="tt-week-now">第{{week}}周</text>
        <view class="tt-week-btn" catchtap="switchWeek" data-week="{{week + 1}}">›</view>
      </view>
      <text class="tt-today">{{header}}</text>
    </view>

    <view class="tt-grid">
      <view class="tt-row tt-head-row">
        <view class="tt-time-cell"></view>
        <view wx:for="{{days}}" wx:key="*this" class="tt-day {{index === todayIdx ? 'today' : ''}}">
          <text>周{{item}}</text>
          <text class="tt-day-date">{{weekDates[index]}}</text>
        </view>
      </view>
      <view wx:for="{{periods}}" wx:for-item="p" wx:for-index="pi" wx:key="label" class="tt-row">
        <view class="tt-time-cell">
          <!-- 作息时间可改：默认 8:00/10:00/…，点击调整为自己学校的作息 -->
          <picker mode="time" value="{{p.time}}" data-index="{{pi}}" bindchange="setPeriodTime">
            <text class="tt-period">第{{p.label}}节</text>
            <text class="tt-clock">{{p.time}}</text>
          </picker>
        </view>
        <view wx:for="{{days}}" wx:for-item="d" wx:for-index="di" wx:key="*this" class="tt-cell {{di === todayIdx ? 'today' : ''}}">
          <!-- 有课：点击进入删除确认 -->
          <view wx:if="{{grid[pi][di]}}" class="tt-course {{grid[pi][di].theme}}" catchtap="removeCourse" data-day="{{di}}" data-period="{{pi}}">
            <text class="tt-course-name">{{grid[pi][di].name}}</text>
            <text class="tt-course-room">{{grid[pi][di].room}}</text>
          </view>
          <!-- 空格：点击添加 -->
          <view wx:else class="tt-cell-add" catchtap="openCompose" data-day="{{di}}" data-period="{{pi}}">＋</view>
        </view>
      </view>
    </view>

    <view class="tt-tip">点空格添加课程 · 点课程删除 · 点时间改作息 · ‹›切周看调休</view>
    <view class="tt-reset" catchtap="resetPeriods">恢复默认作息</view>
  </block>

  <!-- 添加课程表单 -->
  <view wx:if="{{composing}}" class="tt-mask" catchtap="cancelCompose">
    <view class="tt-modal" catchtap="">
      <view class="tt-modal-title">添加课程 · 周{{days[composing.day]}}第{{periods[composing.period].label}}节</view>
      <view class="tt-field">
        <text class="tt-field-label">课程名称</text>
        <input class="tt-field-input" value="{{composeName}}" maxlength="64" placeholder="如 高等数学" bindinput="inputComposeName" focus="{{true}}" />
      </view>
      <view class="tt-field">
        <text class="tt-field-label">教室</text>
        <input class="tt-field-input" value="{{composeRoom}}" maxlength="64" placeholder="如 博学楼 B203（选填）" bindinput="inputComposeRoom" />
      </view>
      <view wx:if="{{composeError}}" class="tt-compose-error">{{composeError}}</view>
      <view class="tt-modal-btns">
        <view class="tt-modal-btn cancel" catchtap="cancelCompose">取消</view>
        <view class="tt-modal-btn ok {{submitting ? 'disabled' : ''}}" catchtap="submitCompose">{{submitting ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>
</view>
