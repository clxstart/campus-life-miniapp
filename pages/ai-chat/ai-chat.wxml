<view class="ai-page">
  <view class="nav" style="padding-top:{{statusBarHeight}}px;height:{{navBarHeight}}px;padding-right:{{capsuleReservedRight}}px">
    <view hover-class="tap" hover-stay-time="80" class="back" catchtap="goBack">‹</view>
    <view class="nav-title">校园小助手</view>
    <view hover-class="tap" hover-stay-time="80" class="nav-action" catchtap="clearChat">清空</view>
  </view>

  <offline-banner local="{{offline}}" />

  <scroll-view
    class="chat-body"
    scroll-y
    scroll-into-view="{{scrollTarget}}"
    scroll-with-animation
    style="padding-bottom:{{keyboardHeight ? 0 : 0}}px"
  >
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
      class="row {{item.role === 'user' ? 'row-user' : 'row-ai'}}"
    >
      <view wx:if="{{item.role !== 'user'}}" class="avatar ai-avatar">✦</view>
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
        <text class="bubble-text">{{item.text}}</text>
      </view>
    </view>

    <view wx:if="{{sending}}" class="row row-ai">
      <view class="avatar ai-avatar">✦</view>
      <view class="bubble bubble-ai typing">
        <text class="dot"></text><text class="dot"></text><text class="dot"></text>
      </view>
    </view>

    <view class="body-bottom"></view>
  </scroll-view>

  <!-- 快捷关键词：优先用回复自带的追问，没有就显示常驻关键词，保证底部永远有可点的词 -->
  <view wx:if="{{!sending}}" class="quick-row">
    <view hover-class="tap" hover-stay-time="80"
      wx:for="{{quickReplies.length ? quickReplies : starterChips}}"
      wx:key="*this"
      class="quick-chip"
      data-text="{{item}}"
      catchtap="tapQuick"
    >{{item}}</view>
  </view>

  <!-- 输入区 -->
  <view class="input-bar">
    <input
      class="input"
      value="{{inputValue}}"
      placeholder="说点什么…"
      placeholder-class="input-ph"
      confirm-type="send"
      maxlength="200"
      bindinput="inputMessage"
      bindconfirm="sendCurrent"
      cursor-spacing="20"
    />
    <view hover-class="tap-btn" hover-stay-time="80"
      class="send-btn {{inputValue && !sending ? 'send-on' : ''}}"
      catchtap="sendCurrent"
    >发送</view>
  </view>

  <!-- 弹窗：必须逐个传声明的属性。
       原来只传了 uiPopup="{{uiPopup}}"（组件没有这个属性），
       visible 一直是默认 false，导致本页所有弹窗都不显示。 -->
  <ui-popup id="ui-popup"
    visible="{{uiPopup.visible}}"
    mode="{{uiPopup.mode}}"
    tone="{{uiPopup.tone}}"
    title="{{uiPopup.title}}"
    message="{{uiPopup.message}}"
    editable="{{uiPopup.editable}}"
    placeholder="{{uiPopup.placeholder}}"
    inputValue="{{uiPopup.inputValue}}"
    actions="{{uiPopup.actions}}"
    show-cancel="{{uiPopup.showCancel}}"
    confirm-text="{{uiPopup.confirmText}}"
    cancel-text="{{uiPopup.cancelText}}"
    bind:confirm="onPopupConfirm"
    bind:cancel="onPopupCancel"
    bind:action="onPopupAction"
    bind:input="onPopupInput"
    bind:close="onPopupClose"
  />
</view>

<!-- 全局悬浮宠物（抬高避开输入框） -->
