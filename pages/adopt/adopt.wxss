@import "../../styles/theme.wxss";
@import "../../styles/common.wxss";

.adopt {
  display: flex;
  flex-direction: column;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部 ===== */
.adopt-head {
  padding: 20rpx 0 26rpx;
}

.adopt-title {
  display: block;
  margin-top: 8rpx;
}

.adopt-sub {
  display: block;
  margin-top: 12rpx;
}

/* ===== 场景 ===== */
.adopt-stage {
  position: relative;
}

.adopt-bubble {
  background: var(--c-card);
  border: var(--bw) solid var(--c-line);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  display: inline-block;
}

.adopt-bubble-text {
  font-size: var(--fs-hint);
  color: var(--c-text-sub);
}

/* ===== 候选行 ===== */
.egg-row {
  display: flex;
  gap: var(--sp-col);
  margin-top: var(--sp-gap);
}

.egg {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 8rpx 12rpx;
  background: var(--c-card);
  border: var(--bw) solid var(--c-line);
  border-radius: 22rpx;
  transition: border-color 140ms ease;
}

.egg--on {
  border: 2rpx solid var(--c-primary);
  background: var(--c-soft);
}

.egg-name {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
}

.egg--on .egg-name {
  color: var(--c-primary);
  font-weight: 600;
}

.egg-check {
  position: absolute;
  right: 10rpx;
  top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--c-primary);
}

/* ===== 底部 ===== */
.adopt-foot {
  margin-top: var(--sp-gap);
}

.adopt-card {
  display: block;
}

.adopt-desc {
  display: block;
  margin-top: 8rpx;
}

.persona-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.persona {
  position: relative;
  padding: 12rpx 26rpx;
  border-radius: var(--radius-pill);
  border: var(--bw) solid var(--c-line);
  background: var(--c-bg);
}

.persona-text {
  font-size: 26rpx;
  color: var(--c-text-sub);
}

.persona.cp-selected .persona-text {
  color: var(--c-primary);
  font-weight: 600;
}

.persona-check {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--c-primary);
  font-weight: 700;
}

.adopt-btn {
  margin-top: var(--sp-gap);
}

/* 原生 button 版主按钮（替代 tdesign t-button theme="primary" block） */
.adopt-btn-main {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  background: var(--c-primary);
  color: var(--c-on-primary);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
}
.adopt-btn-main::after { border: 0; }
.adopt-btn-main[disabled] { opacity: 0.55; }

/* 破壳遮罩（替代 tdesign t-popup placement="center" 的居中弹层） */
.hatch-mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(20, 30, 26, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 900;
}

/* 跳过按钮（替代 tdesign t-button theme="light" size="medium"） */
.hatch-skip {
  margin-top: 22rpx;
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  background: var(--c-soft);
  color: var(--c-text);
  font-size: 26rpx;
  line-height: 1.4;
}

.adopt-tip {
  display: block;
  text-align: center;
  margin-top: 16rpx;
}



/* ===== 破壳演出（图片 + CSS） ===== */
.hatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 56rpx 36rpx;
  background: var(--c-bg);
  border-radius: var(--radius-card);
  min-width: 500rpx;
}

.hatch-stage {
  position: relative;
  width: 220px;
  height: 220px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 宠物：破壳前隐藏，裂开后淡入放大 */
.hatch-pet {
  position: relative;
  z-index: 2;
  width: 180px;
  height: 180px;
  opacity: 0;
  transform: scale(0.72) translateY(16rpx);
  transition: opacity 420ms ease, transform 520ms cubic-bezier(0.34, 1.4, 0.64, 1);
}

.hatch--revealed .hatch-pet {
  opacity: 1;
  transform: scale(1) translateY(0);
  animation: hatch-pop 700ms ease-out;
}

@keyframes hatch-pop {
  0%   { transform: scale(0.86) translateY(10rpx); }
  55%  { transform: scale(1.06) translateY(-6rpx); }
  100% { transform: scale(1) translateY(0); }
}

/* 蛋壳上下两半 */
.hatch-shell {
  position: absolute;
  left: 50%;
  width: 160px;
  height: 90px;
  margin-left: -80px;
  background: #F1E4CB;
  border: 2rpx solid #DCC9A6;
  transition: transform 620ms cubic-bezier(0.34, 1.2, 0.64, 1), opacity 400ms ease;
}

.hatch-shell--top {
  top: 0;
  border-radius: 90px 90px 12px 12px;
  z-index: 3;
}

.hatch-shell--bottom {
  bottom: 0;
  height: 80px;
  border-radius: 12px 12px 90px 90px;
  z-index: 3;
}

/* 裂开：上下分离并放大淡出 */
.hatch--open .hatch-shell--top,
.hatch--revealed .hatch-shell--top {
  transform: translateY(-46rpx) rotate(-9deg);
  opacity: 0.9;
}

.hatch--open .hatch-shell--bottom,
.hatch--revealed .hatch-shell--bottom {
  transform: translateY(40rpx) rotate(7deg);
  opacity: 0.9;
}

.hatch--revealed .hatch-shell--top,
.hatch--revealed .hatch-shell--bottom {
  opacity: 0;
}

.hatch-title {
  margin: 18rpx 0 24rpx;
  font-size: var(--fs-card-title);
  font-weight: 600;
  color: var(--c-text);
}

@media (prefers-reduced-motion: reduce) {
  .hatch-pet, .hatch-shell { transition: none; animation: none; }
}
