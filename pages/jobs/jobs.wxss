page{background:#f7f9fb}.jobs-page{min-height:100vh;color:#18212b}.nav{box-sizing:content-box;display:flex;align-items:center;padding-left:28rpx;background:#fff
  box-shadow: 0 2rpx 0 #eef1f4; /* 白导航压在浅底上，加分隔线否则边界看不清 */
}.nav-title{font-size:34rpx;font-weight:700}.back{padding:0 12rpx;margin-right:16rpx;font-size:42rpx}/* 搜索：白色底条与下方 chips 连成一片 */
.search-bar{padding:12rpx 28rpx 16rpx;background:#fff}.search-box{display:flex;align-items:center;height:76rpx;padding:0 22rpx;border-radius:38rpx;background:#f2f5f8}.search-mark{margin-right:14rpx;color:#2a9a67;font-size:38rpx}.search-input{flex:1;min-width:0;height:60rpx;font-size:25rpx}.search-placeholder{color:#98a2ac}.search-clear{padding:8rpx 12rpx;color:#98a2ac;font-size:34rpx}.result-hint{padding:18rpx 28rpx 0;color:#8e98a1;font-size:21rpx}.chips{height:86rpx;background:#fff}.chip-row{display:flex;gap:16rpx;padding:20rpx 28rpx}.chip{flex:none;padding:10rpx 24rpx;border-radius:28rpx;background:#f2f5f8;color:#737e88;font-size:22rpx}.chip.active{background:#e5f7ed;color:#2a9a67;font-weight:600}.job-list{padding:22rpx 24rpx}.job-card{display:flex;align-items:flex-start;margin-bottom:18rpx;padding:25rpx 22rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(36,62,96,.06)}.job-main{flex:1;min-width:0}.job-title{font-size:29rpx;line-height:40rpx;font-weight:650}.job-salary{margin-top:8rpx;color:#20a66a;font-size:34rpx;font-weight:800}.job-meta{display:flex;align-items:center;gap:12rpx;margin-top:15rpx}.settle-tag{padding:5rpx 10rpx;border-radius:8rpx;background:#f0f2f4;color:#8a949d;font-size:19rpx}.location{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#7c8790;font-size:21rpx}.job-time{margin-top:10rpx;color:#8e98a1;font-size:20rpx}.job-status{display:flex;align-items:center;gap:8rpx;flex:none;margin-left:14rpx;color:#2a9a67;font-size:20rpx}.status-dot{width:14rpx;height:14rpx;border-radius:50%;background:#38c17d}.state{padding:180rpx 0;text-align:center;color:#9aa4ad;font-size:24rpx}.state-title{display:block;margin-bottom:10rpx;color:#45515c;font-size:29rpx;font-weight:600}

/* 本校/全部切换：分段控件 */
.scope-switch{display:flex;margin-left:auto;margin-right:16rpx;padding:4rpx;border-radius:22rpx;background:#f0f2f4}
.scope-opt{padding:8rpx 20rpx;border-radius:18rpx;color:#737e88;font-size:21rpx}
.scope-opt.on{background:#fff;color:#3476f6;font-weight:600;box-shadow:0 2rpx 6rpx rgba(36,62,96,.08)}

/* 触底加载提示：列表底部一行小字，不抢内容注意力 */
.list-more {
  padding: 32rpx 0 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8A9992;
}
