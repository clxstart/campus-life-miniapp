.profile-page {
  min-height: 100vh;
  background: #f6f8fb;
}

.profile-navbar {
  background: rgba(246, 248, 251, 0.97);
}

.profile-navbar-row {
  padding-left: 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-page-title {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: #111820;
}

.settings-button {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #596672;
  font-size: 24rpx;
}

.profile-content {
  padding: 14rpx 32rpx calc(130rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  position: relative;
  height: 300rpx;
  padding: 24rpx;
  overflow: hidden;
  border-radius: 25rpx;
  background: linear-gradient(135deg, #dcecff, #e8f8f1 62%, #fff0f5);
  box-shadow: 0 8rpx 24rpx rgba(74, 112, 151, 0.09);
}

.hero-ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(69, 139, 226, 0.17);
}

.ring-a {
  width: 230rpx;
  height: 230rpx;
  right: -70rpx;
  top: -96rpx;
}

.ring-b {
  width: 145rpx;
  height: 145rpx;
  right: -20rpx;
  top: -55rpx;
}

.profile-main {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  flex: none;
  width: 94rpx;
  height: 94rpx;
}

.profile-avatar {
  width: 94rpx;
  height: 94rpx;
  border-radius: 30rpx;
  background: #dceaff;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
}

.verified-dot {
  position: absolute;
  right: -3rpx;
  bottom: -2rpx;
  width: 25rpx;
  height: 25rpx;
  border-radius: 50%;
  border: 3rpx solid #e8f4fb;
  background: #3476f6;
  color: #ffffff;
  font-size: 13rpx;
  line-height: 22rpx;
  text-align: center;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 17rpx;
  display: flex;
  flex-direction: column;
}

.profile-name-row {
  display: flex;
  align-items: center;
}

.profile-name {
  font-size: 28rpx;
  line-height: 37rpx;
  font-weight: 700;
  color: #162c3f;
}

.campus-chip {
  margin-left: 9rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(69, 139, 229, 0.12);
  color: #3d84dd;
  font-size: 12rpx;
  line-height: 18rpx;
}

/* 认证状态：未认证用中性灰，避免和"已认证"的蓝色徽章混淆 */
.campus-chip.off {
  background: rgba(120, 130, 145, 0.12);
  color: #7c8794;
}

.campus-chip.ok {
  background: rgba(69, 139, 229, 0.12);
  color: #3d84dd;
}

.profile-major {
  margin-top: 5rpx;
  font-size: 16rpx;
  line-height: 23rpx;
  color: #637c8f;
}

.profile-id {
  margin-top: 3rpx;
  font-size: 14rpx;
  line-height: 20rpx;
  color: #89a0b1;
}

.edit-profile {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: 15rpx;
  border: 1rpx solid rgba(55, 121, 214, 0.35);
  color: #3476ce;
  font-size: 15rpx;
}

.stats-row {
  position: absolute;
  z-index: 2;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  height: 83rpx;
  border-radius: 19rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(12rpx);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 700;
  color: #1b3448;
}

.stat-label {
  margin-top: 2rpx;
  font-size: 14rpx;
  color: #8295a4;
}

.stat-divider {
  width: 1rpx;
  height: 35rpx;
  background: rgba(107, 139, 163, 0.19);
}

.profile-section-title {
  display: block;
  margin-top: 25rpx;
  font-size: 23rpx;
  line-height: 31rpx;
  font-weight: 600;
  color: #18232d;
}

.service-grid {
  margin-top: 13rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13rpx;
}

.service-card {
  height: 135rpx;
  padding: 15rpx;
  border-radius: 19rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 17rpx rgba(48, 69, 89, 0.045);
}

.service-icon {
  width: 39rpx;
  height: 39rpx;
  border-radius: 13rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 600;
}

.service-name,
.service-desc {
  display: block;
}

.service-name {
  margin-top: 9rpx;
  font-size: 17rpx;
  line-height: 23rpx;
  font-weight: 600;
  color: #202a33;
}

.service-desc {
  margin-top: 1rpx;
  font-size: 13rpx;
  line-height: 18rpx;
  color: #9aa1a8;
}

.campus-card {
  min-height: 116rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 21rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #e1efff, #edf9f3);
}

.campus-card-icon {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #4b91ed;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(74, 140, 226, 0.18);
}

.campus-card-copy {
  flex: 1;
  min-width: 0;
  margin-left: 15rpx;
  display: flex;
  flex-direction: column;
}

.campus-card-eyebrow {
  font-size: 11rpx;
  line-height: 16rpx;
  letter-spacing: 2rpx;
  color: #5590d4;
}

.campus-card-title {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 27rpx;
  font-weight: 600;
  color: #19364d;
}

.campus-card-desc {
  margin-top: 3rpx;
  font-size: 14rpx;
  line-height: 20rpx;
  color: #7590a3;
}

.campus-card-arrow,
.menu-arrow {
  flex: none;
  color: #96a5b0;
  font-size: 31rpx;
}

.menu-heading {
  margin-top: 24rpx;
}

.profile-menu {
  margin-top: 13rpx;
  overflow: hidden;
  border-radius: 21rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 17rpx rgba(48, 69, 89, 0.04);
}

.menu-row {
  min-height: 72rpx;
  padding: 13rpx 17rpx;
  display: flex;
  align-items: center;
}

.menu-row + .menu-row {
  border-top: 1rpx solid #eef1f4;
}

.menu-icon {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 15rpx;
}

.menu-icon.blue { background: #589df0; }
.menu-icon.green { background: #62c78e; }
.menu-icon.yellow { background: #edb44f; }
.menu-icon.purple { background: #a184dc; }
.menu-icon.gray { background: #8f9ba5; }

.menu-title {
  flex: 1;
  margin-left: 12rpx;
  font-size: 18rpx;
  color: #26313a;
}

.menu-value {
  margin-right: 7rpx;
  font-size: 14rpx;
  color: #9aa2a9;
}

.menu-arrow {
  font-size: 27rpx;
}
