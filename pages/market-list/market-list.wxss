page{background:#f7f9fb}.market-page{min-height:100vh;padding-bottom:calc(150rpx + env(safe-area-inset-bottom));color:#18212b}.nav{box-sizing:content-box;display:flex;align-items:center;padding-left:28rpx;background:#fff
  box-shadow: 0 2rpx 0 #eef1f4; /* 白导航压在浅底上，加分隔线否则边界看不清 */
}.nav-title{font-size:34rpx;font-weight:700;flex:1}.back{padding:0 12rpx;margin-right:16rpx;font-size:42rpx}/* 本校/全部切换：分段控件 */
.scope-switch{display:flex;margin-right:24rpx;padding:4rpx;border-radius:22rpx;background:#f0f2f4}.scope-opt{padding:8rpx 20rpx;border-radius:18rpx;color:#737e88;font-size:21rpx}.scope-opt.on{background:#fff;color:#3476f6;font-weight:600;box-shadow:0 2rpx 6rpx rgba(36,62,96,.08)}.mode-tabs{display:flex;align-items:center;gap:44rpx;padding:0 32rpx;height:88rpx;background:#fff;border-bottom:1rpx solid #edf1f4}.mode-tab{position:relative;flex:none;padding:0 4rpx;line-height:88rpx;color:#8a949d;font-size:30rpx}.mode-tab.active{color:#18212b;font-weight:700}.mode-tab.active:after{content:'';position:absolute;bottom:6rpx;left:50%;transform:translateX(-50%);width:40rpx;height:6rpx;border-radius:6rpx;background:#3476f6}.chips{height:86rpx;background:#fff}.chip-row{display:flex;gap:16rpx;padding:20rpx 28rpx}.chip{flex:none;padding:10rpx 22rpx;border-radius:28rpx;background:#f2f5f8;color:#737e88;font-size:22rpx}.chip.active{background:#e7f0ff;color:#3476f6;font-weight:600}.goods-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;padding:22rpx 24rpx}.goods-card{overflow:hidden;background:#fff;border-radius:20rpx;box-shadow:0 8rpx 22rpx rgba(36,62,96,.06)}.goods-image{display:block;width:100%;height:300rpx;background:#edf2f6}.goods-body{padding:16rpx 16rpx 18rpx}.goods-title{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:26rpx;line-height:38rpx;color:#26323d}.goods-price{margin-top:8rpx;color:#ef5b55;font-size:31rpx;font-weight:700}.condition{display:inline-block;margin-top:9rpx;padding:4rpx 10rpx;border-radius:8rpx;background:#fff1e8;color:#d98643;font-size:18rpx}.seller{display:flex;align-items:center;margin-top:16rpx;min-width:0}.seller-avatar{width:34rpx;height:34rpx;line-height:34rpx;border-radius:50%;color:#fff;text-align:center;font-size:18rpx}.seller-name{margin-left:8rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#8d969e;font-size:19rpx}.state{padding:160rpx 0;text-align:center;color:#9aa4ad;font-size:24rpx}.state-title{display:block;margin-bottom:10rpx;color:#45515c;font-size:29rpx;font-weight:600}
.fab{position:fixed;right:30rpx;bottom:calc(40rpx + env(safe-area-inset-bottom));width:108rpx;height:108rpx;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#3476f6;color:#fff;box-shadow:0 10rpx 28rpx rgba(52,118,246,.4);z-index:5}.fab text{font-size:38rpx;line-height:40rpx}.fab label{font-size:19rpx}
