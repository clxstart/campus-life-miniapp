page { background: #f7f9fb; }
.pet-page { min-height: 100vh; padding-bottom: 60rpx; color: #18212b; }

.nav {
  box-sizing: content-box;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 0 #eef1f4;
}
.nav-title { font-size: 34rpx; font-weight: 700; }
.back { padding: 0 14rpx; margin-right: 12rpx; font-size: 42rpx; }
.points-pill {
  margin-left: auto;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  background: #fff7e8;
  color: #b07a1f;
  font-size: 22rpx;
  font-weight: 600;
}

/* 形象区 */
.stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 540rpx;
  margin: 28rpx 24rpx 0;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #eaf2ff 0%, #f7f9fb 100%);
  /* 不用 overflow:hidden，避免放大动画时被裁切 */
}
.pet-img {
  position: absolute;
  width: 440rpx;
  height: 440rpx;
  transform-origin: 50% 78%;
  will-change: transform, opacity;
  backface-visibility: hidden;
}
.skin-btn {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .85);
  color: #3476f6;
  font-size: 22rpx;
  font-weight: 600;
}

/* ============ 底图：常驻呼吸 + 轻微摇头（模拟头动）============ */
.pet-img.base {
  animation: baseIdle 4s ease-in-out infinite;
}
@keyframes baseIdle {
  0%   { transform: translate3d(0,0,0)     rotate(-1.6deg) scale(1); }
  25%  { transform: translate3d(0,-6rpx,0) rotate(0deg)     scale(1.015); }
  50%  { transform: translate3d(0,0,0)     rotate(1.6deg)   scale(1); }
  75%  { transform: translate3d(0,-6rpx,0) rotate(0deg)     scale(1.015); }
  100% { transform: translate3d(0,0,0)     rotate(-1.6deg)  scale(1); }
}

/* 眨眼：整图纵向轻压（模拟眼睛闭合） */
.pet-img.base.blinking {
  animation: baseIdle 4s ease-in-out infinite, blinkAnim .16s ease-in-out;
}
@keyframes blinkAnim {
  0%   { transform: scaleY(1); }
  50%  { transform: scaleY(.86) translateY(4rpx); }
  100% { transform: scaleY(1); }
}

/* ============ 动效层：叠在底图上 ============ */
.pet-img.effect { animation-fill-mode: both; }

/* 开心：蹦一下 + 弹跳 */
.pet-img.effect.fx-pop {
  animation: fxPop 1.3s cubic-bezier(.34,1.56,.64,1) both;
}
@keyframes fxPop {
  0%   { transform: translate3d(0,0,0) scale(1);         opacity: 0; }
  12%  { transform: translate3d(0,0,0) scale(1);         opacity: 1; }
  35%  { transform: translate3d(0,-42rpx,0) scale(1.09); opacity: 1; }
  55%  { transform: translate3d(0,0,0) scale(.97);       opacity: 1; }
  72%  { transform: translate3d(0,-16rpx,0) scale(1.03); opacity: 1; }
  100% { transform: translate3d(0,0,0) scale(1);         opacity: 0; }
}

/* 委屈：左右发抖 */
.pet-img.effect.fx-tremble {
  animation: fxTremble 1.2s ease-in-out both;
}
@keyframes fxTremble {
  0%   { transform: translate3d(0,0,0) rotate(0deg);        opacity: 0; }
  10%  { opacity: 1; }
  20%  { transform: translate3d(-7rpx,0,0) rotate(-2deg); }
  35%  { transform: translate3d(7rpx,0,0)  rotate(2deg); }
  50%  { transform: translate3d(-6rpx,0,0) rotate(-1.6deg); }
  65%  { transform: translate3d(6rpx,0,0)  rotate(1.6deg); }
  80%  { transform: translate3d(-3rpx,0,0) rotate(-1deg); }
  90%  { opacity: 1; }
  100% { transform: translate3d(0,0,0) rotate(0deg);        opacity: 0; }
}

/* 困倦：缓慢下沉 + 淡出 */
.pet-img.effect.fx-doze {
  animation: fxDoze 1.6s ease-in-out both;
}
@keyframes fxDoze {
  0%   { transform: translate3d(0,0,0) scale(1);                     opacity: 0; }
  15%  { opacity: 1; }
  45%  { transform: translate3d(0,14rpx,0) scale(.94) rotate(-3deg); opacity: 1; }
  70%  { transform: translate3d(0,18rpx,0) scale(.92) rotate(-4deg); opacity: 1; }
  88%  { opacity: 1; }
  100% { transform: translate3d(0,22rpx,0) scale(.9) rotate(-4deg);  opacity: 0; }
}

/* 升级：放大爆闪 + 上浮 */
.pet-img.effect.fx-burst {
  animation: fxBurst 1.5s cubic-bezier(.22,1,.36,1) both;
}
@keyframes fxBurst {
  0%   { transform: translate3d(0,0,0) scale(.6);        opacity: 0; }
  18%  { transform: translate3d(0,0,0) scale(1.16);      opacity: 1; }
  32%  { transform: translate3d(0,-10rpx,0) scale(1.02); opacity: 1; }
  55%  { transform: translate3d(0,-26rpx,0) scale(1.1);  opacity: 1; }
  80%  { transform: translate3d(0,-34rpx,0) scale(1.05); opacity: .85; }
  100% { transform: translate3d(0,-42rpx,0) scale(1);    opacity: 0; }
}

/* 名字与等级 */
.pet-head {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 14rpx;
  margin-top: 18rpx;
}
.pet-name { font-size: 36rpx; font-weight: 700; }
.pet-level {
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
  background: #3476f6;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

/* 状态条 */
.bars-card {
  margin: 26rpx 24rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(36, 62, 96, .05);
}
.bar-row { display: flex; align-items: center; }
.bar-row + .bar-row { margin-top: 20rpx; }
.bar-label { width: 84rpx; font-size: 22rpx; color: #737e88; }
.bar-track {
  flex: 1;
  height: 16rpx;
  border-radius: 8rpx;
  background: #eef1f4;
  overflow: hidden;
}
.bar-fill { height: 100%; border-radius: 8rpx; }
.bar-fill.hunger { background: #ffa940; }
.bar-fill.mood { background: #3476f6; }
.bar-fill.exp { background: #52c41a; }
.bar-num { width: 110rpx; text-align: right; font-size: 20rpx; color: #737e88; }

/* 操作按钮 */
.actions {
  display: flex;
  gap: 18rpx;
  margin: 28rpx 24rpx 0;
}
.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 0 22rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(36, 62, 96, .05);
}
.action-btn.disabled { opacity: .5; }
.action-icon { font-size: 44rpx; }
.action-name { margin-top: 10rpx; font-size: 26rpx; font-weight: 600; }
.action-cost { margin-top: 6rpx; font-size: 19rpx; color: #737e88; }

/* 形象选择面板 */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(16, 24, 36, .45);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 76vh;
  padding: 28rpx 24rpx 40rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-close { padding: 0 10rpx; font-size: 34rpx; color: #9aa4ad; }
.sheet-tip { margin-top: 8rpx; font-size: 20rpx; color: #9aa4ad; }

.skin-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  max-height: 56vh;
  margin-top: 22rpx;
}
.skin-item {
  width: calc((100% - 48rpx) / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 6rpx 12rpx;
  border-radius: 20rpx;
  background: #f7f9fb;
  border: 2rpx solid transparent;
}
.skin-item.active {
  border-color: #3476f6;
  background: #eef4ff;
}
.skin-thumb { width: 92rpx; height: 92rpx; }
.skin-name { margin-top: 8rpx; font-size: 19rpx; font-weight: 600; text-align: center; }
.skin-pack { margin-top: 2rpx; font-size: 16rpx; color: #9aa4ad; }

.state { padding: 220rpx 0; text-align: center; color: #9aa4ad; font-size: 26rpx; }
