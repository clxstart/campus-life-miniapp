<view class="editor-page">
  <view class="nav" style="height:{{navBarHeight}}px;padding-top:{{statusBarHeight}}px;padding-right:{{capsuleReservedRight}}px;"><view hover-class="tap" hover-stay-time="80" class="nav-back" catchtap="goBack"><view class="back-stroke"></view></view><text class="nav-title">分享学习日常</text></view>
  <offline-banner />
  <view class="editor-content">
    <view class="editor-intro"><view class="intro-copy"><text class="intro-kicker">SHARE TO GROW</text><text class="intro-title">你的经验，<text class="intro-line">也许正是他人的灵感。</text></text><text class="intro-subtitle">好问题，值得被一起解开。</text></view><image class="intro-art" src="/assets/learn/books.png" mode="aspectFit" /></view>
    <view class="section-heading"><text class="section-title">分享去哪里</text><text class="section-aside">选择一个学习板块</text></view>
    <view class="category-card"><view class="category-grid"><view hover-class="tap-card" hover-stay-time="80" wx:for="{{categories}}" wx:key="key" class="category-chip {{category === item.key ? 'chip-active' : ''}}" data-key="{{item.key}}" catchtap="chooseCategory">{{item.label}}</view></view><text class="category-note">{{current.hint}}</text></view>
    <view class="writing-card"><input class="title-input" value="{{title}}" maxlength="64" disabled="{{submitting}}" placeholder="给这份分享起个标题" placeholder-class="input-placeholder" bindinput="inputTitle" /><view class="writing-rule"></view><textarea class="content-input" value="{{content}}" maxlength="3000" disabled="{{submitting}}" placeholder="说说你的问题、经验或发现。写下已经尝试的方法，让交流更有收获…" placeholder-class="input-placeholder" bindinput="inputContent" /><view class="character-count">{{content.length}} / 3000</view><view class="media-row"><view wx:if="{{media.length}}" class="media-preview"><image class="picked-image" src="{{media[0]}}" mode="aspectFill" /><view hover-class="tap" hover-stay-time="80" class="remove-image" catchtap="removeMedia">×</view></view><view hover-class="tap" hover-stay-time="80" wx:else class="media-add" catchtap="chooseMedia"><view class="camera-mark">＋</view><text>添加图片</text><text class="media-note">让分享更具体</text></view><text class="media-hint">分享真实的学习记录，<text class="media-hint-line">也保留自己的独立思考。</text></text></view></view>
    <view class="settings-card"><view hover-class="tap-card" hover-stay-time="80" class="setting-row" catchtap="chooseLocation"><view class="setting-icon">⌖</view><view class="setting-copy"><text class="setting-title">所在位置</text><text class="setting-subtitle">{{location || '不显示位置'}}</text></view><text class="setting-arrow">›</text></view><view class="setting-divider"></view><view class="setting-row"><view class="setting-icon school-icon">校</view><view class="setting-copy"><text class="setting-title">仅当前学校可见</text><text class="setting-subtitle">{{schoolName || '请先在首页选择学校'}}</text></view><text class="school-check">✓</text></view></view>
    <text class="editor-footnote">一份真诚的分享，会让成长多一点回响。</text>
  </view>
  <view class="submit-dock"><button hover-class="tap-btn" hover-stay-time="80" class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在分享…' : '发布到' + current.label}}</button></view>
  <ui-popup id="ui-popup" visible="{{uiPopup.visible}}" mode="{{uiPopup.mode}}" tone="{{uiPopup.tone}}" title="{{uiPopup.title}}" message="{{uiPopup.message}}" editable="{{uiPopup.editable}}" placeholder="{{uiPopup.placeholder}}" inputValue="{{uiPopup.inputValue}}" actions="{{uiPopup.actions}}" show-cancel="{{uiPopup.showCancel}}" confirm-text="{{uiPopup.confirmText}}" cancel-text="{{uiPopup.cancelText}}" bindconfirm="onPopupConfirm" bindcancel="onPopupCancel" bindaction="onPopupAction" bindinput="onPopupInput" bindclose="onPopupClose" />
</view>
<!-- 全局悬浮宠物 -->
