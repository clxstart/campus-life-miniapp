/* 学习发布：浅蓝、暖白与留白，单独承载学习流程，沿用原生帖子接口。 */
.editor-page{min-height:100vh;background:#fcfcfc;color:#213449}
.nav{box-sizing:content-box;display:flex;align-items:center;padding-left:28rpx;background:#fff;box-shadow:0 2rpx 0 #eef1f4}
.nav-back{width:48rpx;height:64rpx;display:flex;align-items:center;justify-content:flex-start;flex-shrink:0}
.back-stroke{width:18rpx;height:18rpx;border-left:3rpx solid #213449;border-bottom:3rpx solid #213449;transform:rotate(45deg);margin-left:8rpx}
.nav-title{font-size:32rpx;font-weight:600;white-space:nowrap}
.editor-content{padding:28rpx 28rpx calc(178rpx + env(safe-area-inset-bottom))}
.editor-intro{position:relative;padding:30rpx 28rpx;min-height:238rpx;border-radius:24rpx;background:#edf4ff;overflow:hidden}
.intro-copy{position:relative;z-index:1;max-width:540rpx}
.intro-kicker{display:block;font-size:18rpx;letter-spacing:3rpx;color:#6c8aaf}
.intro-title{display:block;font-size:34rpx;font-weight:600;line-height:52rpx;margin-top:14rpx;color:#274b78}
.intro-line{display:block}
.intro-subtitle{display:block;font-size:22rpx;color:#7d93ac;line-height:34rpx;margin-top:14rpx}
.intro-art{position:absolute;width:200rpx;height:160rpx;right:-22rpx;bottom:0;opacity:.4}
.section-heading{display:flex;align-items:center;justify-content:space-between;margin:30rpx 2rpx 18rpx}
.section-title{font-size:28rpx;font-weight:600}
.section-aside{font-size:21rpx;color:#97a2ad}
.category-card{padding:24rpx;border-radius:24rpx;background:#fff;box-shadow:0 4rpx 18rpx rgba(32,59,86,.04)}
.category-grid{display:flex;flex-wrap:wrap;gap:14rpx}
.category-chip{height:64rpx;padding:0 22rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:#f1f4f8;color:#737e88;font-size:24rpx}
.chip-active{background:#3476f6;color:#fff;font-weight:500}
.category-note{display:block;margin-top:20rpx;font-size:22rpx;line-height:34rpx;color:#97a2ad}
.writing-card{margin-top:24rpx;padding:28rpx;border-radius:24rpx;background:#fff;box-shadow:0 4rpx 18rpx rgba(32,59,86,.04)}
.title-input{font-size:32rpx;font-weight:600;height:64rpx;line-height:64rpx;color:#213449;width:100%}
.input-placeholder{color:#b1bac5;font-weight:400}
.writing-rule{height:1rpx;background:#f0f3f7;margin:18rpx 0 24rpx}
.content-input{width:100%;height:300rpx;font-size:28rpx;line-height:46rpx;color:#576c83}
.character-count{text-align:right;font-size:20rpx;color:#a8b2bf;margin-top:12rpx}
.media-row{display:flex;align-items:center;gap:24rpx;margin-top:24rpx}
.media-add{width:164rpx;height:164rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;flex-direction:column;border-radius:20rpx;background:#f3f6fa;font-size:22rpx;color:#7b91ac;gap:6rpx}
.camera-mark{font-size:38rpx;line-height:42rpx;color:#7c9ac0}
.media-note{font-size:18rpx;color:#abb6c3}
.media-preview{position:relative;width:164rpx;height:164rpx;flex-shrink:0}
.picked-image{width:100%;height:100%;border-radius:20rpx}
.remove-image{position:absolute;top:-8rpx;right:-8rpx;width:44rpx;height:44rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:32rpx;background:#435b79;color:#fff}
.media-hint{font-size:21rpx;line-height:36rpx;color:#a0adbb}
.media-hint-line{display:block}
.settings-card{margin-top:24rpx;padding:4rpx 28rpx;border-radius:24rpx;background:#fff}
.setting-row{display:flex;align-items:center;gap:18rpx;padding:24rpx 0}
.setting-icon{width:56rpx;height:56rpx;border-radius:18rpx;background:#edf4ff;color:#7297c9;font-size:30rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.school-icon{font-size:24rpx;background:#eff5f0;color:#7d9c89}
.setting-copy{flex:1;min-width:0}
.setting-title{display:block;font-size:25rpx;line-height:38rpx}
.setting-subtitle{display:block;font-size:22rpx;line-height:34rpx;margin-top:4rpx;color:#97a2ad;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.setting-arrow{font-size:38rpx;color:#9aacc2}
.school-check{color:#6d9c80;font-size:28rpx}
.setting-divider{height:1rpx;background:#f0f3f7}
.editor-footnote{display:block;text-align:center;font-size:20rpx;line-height:34rpx;color:#a3adba;letter-spacing:1rpx;margin-top:28rpx}
.submit-dock{position:fixed;bottom:0;left:0;right:0;z-index:2;padding:22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -2rpx 0 #f0f3f7}
.submit-button{height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:#3476f6;color:#fff;font-size:28rpx;font-weight:500;margin:0;padding:0}
.submit-button::after{border:0}
