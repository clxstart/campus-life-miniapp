@import "../../styles/theme.wxss";
@import "../../styles/common.wxss";

.redeem-page {
  min-height: 100vh;
  background: var(--c-bg);
}

.redeem-body {
  padding: var(--sp-gap) var(--sp-page) calc(var(--sp-page) + var(--safe-bottom));
}

/* ===== 顶部余额 ===== */
.balance-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.balance-right {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.balance-number {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--c-primary);
  line-height: 1.1;
}

.compliance {
  display: block;
  margin-top: 14rpx;
}

/* ===== 兑换成功后的引导条 ===== */
.guide-card {
  margin-top: var(--sp-gap);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.guide-link {
  flex: none;
  color: var(--c-primary);
  font-size: var(--fs-hint);
  font-weight: 600;
}

/* ===== 区块标题 ===== */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--sp-gap) 0 4rpx;
}

.redeem-title {
  font-size: var(--fs-card-title);
}

.points-link {
  color: var(--c-primary);
  font-size: var(--fs-hint);
}

/* ===== 商品网格 ===== */
.item-grid {
  margin-top: var(--sp-gap);
}

.item-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-disabled {
  opacity: 0.55;
}

.item-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-text);
  line-height: 1.4;
}

.item-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--c-accent);
}

.item-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}

.item-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  margin-top: 12rpx;
  font-size: var(--fs-hint);
}

.item-busy,
.item-state {
  display: block;
  height: 64rpx;
  line-height: 64rpx;
  margin-top: 12rpx;
  border-radius: var(--radius-pill);
  text-align: center;
  font-size: var(--fs-hint);
  background: var(--c-soft);
  color: var(--c-text-sub);
}

/* ===== 状态 ===== */
.state {
  padding: 80rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.state-title {
  font-size: var(--fs-card-title);
  font-weight: 600;
  color: var(--c-text);
}

.state-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 44rpx;
  margin-top: 8rpx;
  font-size: var(--fs-hint);
}

.bottom-hint {
  display: block;
  margin-top: var(--sp-gap);
  text-align: center;
}