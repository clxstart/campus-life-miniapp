page{background:#f6f8fb}.detail-page{min-height:100vh;padding-bottom:140rpx;color:#18212b}.nav{box-sizing:content-box;display:flex;align-items:center;padding-left:28rpx;background:#fff
  box-shadow: 0 2rpx 0 #eef1f4; /* 白导航压在浅底上，加分隔线否则边界看不清 */
}.nav-title{font-size:34rpx;font-weight:700}.back{padding:0 12rpx;margin-right:16rpx;font-size:42rpx}.detail-image{display:block;width:100%;height:500rpx;background:#e9eef3}.detail-swiper{width:100%;height:500rpx;background:#e9eef3}.detail-swiper-image{width:100%;height:500rpx}.detail-main{padding:30rpx 30rpx 24rpx;background:#fff}.price-row{display:flex;align-items:center;gap:16rpx}.detail-price{color:#ef5b55;font-size:52rpx;font-weight:800}.condition{padding:7rpx 14rpx;border-radius:10rpx;background:#fff1e8;color:#d98643;font-size:21rpx}.created{margin-top:12rpx;color:#99a3ad;font-size:21rpx}.detail-title{margin-top:25rpx;font-size:34rpx;line-height:48rpx;font-weight:700}.description{margin-top:20rpx;color:#5f6b76;font-size:26rpx;line-height:1.8;white-space:pre-wrap}.seller-card{display:flex;align-items:center;margin:22rpx 24rpx;padding:22rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(36,62,96,.05)}.seller-avatar{width:74rpx;height:74rpx;line-height:74rpx;border-radius:50%;color:#fff;text-align:center;font-size:34rpx;font-weight:700}.seller-copy{flex:1;min-width:0;margin-left:18rpx}.seller-name{display:block;font-size:28rpx;font-weight:600}.seller-note{display:block;margin-top:8rpx;color:#9aa4ad;font-size:20rpx}.seller-link{color:#3476f6;font-size:23rpx}.bottom-bar{position:fixed;z-index:5;left:0;right:0;bottom:0;display:flex;align-items:center;gap:18rpx;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:1rpx solid #e9eef3}.fav-button{flex:none;width:200rpx;height:86rpx;padding:0;margin:0;border-radius:44rpx;background:#f2f5f8;color:#63707c;font-size:26rpx;line-height:1;display:flex;align-items:center;justify-content:center}.fav-button.on{background:#fff4e6;color:#d98643}.want-button{flex:1;height:86rpx;padding:0;margin:0;border-radius:44rpx;background:#3476f6;color:#fff;font-size:28rpx;font-weight:600;line-height:1;display:flex;align-items:center;justify-content:center}.fav-button::after,.want-button::after{border:none}.state{text-align:center;padding:180rpx 0;color:#9aa4ad;font-size:24rpx}.state-title{display:block;margin-bottom:12rpx;color:#45515c;font-size:29rpx}.delete-button{flex:1;height:86rpx;padding:0;margin:0;border-radius:44rpx;background:#fdecec;color:#c0392b;font-size:28rpx;font-weight:600;line-height:1;display:flex;align-items:center;justify-content:center;border:1rpx solid #f5c6c6}.delete-button::after{border:none}