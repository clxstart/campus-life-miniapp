<page-meta page-style="background:#F6F8FB;" />
<view class="cd-page">
  <view class="cd-nav" style="padding-top:{{statusBarHeight}}px;">
    <view class="cd-nav-row" style="height:{{navBarHeight}}px;padding-right:{{capsuleReservedRight}}px">
      <view hover-class="tap" hover-stay-time="80" class="cd-back" catchtap="goBack">‹</view>
      <text class="cd-nav-title">{{circle ? circle.name : '圈子'}}</text>
    </view>
  </view>
  <offline-banner local="{{offline}}" />

  <view wx:if="{{loading && !circle}}" class="cd-state">正在加载圈子…</view>
  <view wx:elif="{{error}}" class="cd-state">
    <text class="cd-state-title">{{error}}</text>
    <view hover-class="tap-btn" hover-stay-time="80" class="cd-state-btn" bindtap="goBack">返回圈子列表</view>
  </view>

  <block wx:else>
    <view class="cd-header">
      <image class="cd-cover-bg" src="{{circle.cover}}" mode="aspectFill" />
      <view class="cd-cover-mask"></view>
      <view class="cd-header-copy">
        <view class="cd-header-top">
          <text class="cd-name">{{circle.name}}</text>
          <text class="cd-category">{{circle.category}}</text>
        </view>
        <text class="cd-desc">{{circle.description}}</text>
        <view class="cd-stats">
          <text>{{circle.memberCount}} 成员</text>
          <text class="cd-dot">·</text>
          <text>{{circle.postCount}} 帖子</text>
        </view>
      </view>
      <view hover-class="tap" hover-stay-time="80" class="cd-join {{circle.joined ? 'joined' : ''}}" catchtap="toggleJoin">
        {{circle.joined ? '已加入' : '＋ 加入圈子'}}
      </view>
    </view>

    <view class="cd-toolbar">
      <text class="cd-section">圈内动态</text>
      <view class="cd-toolbar-actions">
        <view hover-class="tap-card" hover-stay-time="80" class="cd-chat-entry" bindtap="openChat">群聊<text wx:if="{{circle.unreadCount > 0}}" class="cd-chat-badge">{{circle.unreadCount > 99 ? '99+' : circle.unreadCount}}</text></view>
        <view hover-class="tap" hover-stay-time="80" class="cd-compose" bindtap="openCompose">＋ 发帖</view>
      </view>
    </view>

    <view class="cd-loading" wx:if="{{loading}}">正在加载…</view>
    <view class="cd-empty" wx:if="{{!loading && !posts.length}}">
      <text class="cd-empty-icon">◌</text>
      <text>圈子里还没有帖子，来发第一条吧</text>
    </view>

    <view hover-class="tap-card" hover-stay-time="80"
      wx:for="{{posts}}"
      wx:key="id"
      class="cd-card"
      data-id="{{item.id}}"
      bindtap="openPost"
    >
      <view class="cd-author">
        <image wx:if="{{item.avatar}}" class="cd-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view wx:else class="cd-avatar cd-avatar-text">{{item.avatarText}}</view>
        <view class="cd-author-copy">
          <text class="cd-author-name">{{item.author}}</text>
          <text class="cd-author-time">{{item.time}}{{item.location ? ' · ' + item.location : ''}}</text>
        </view>
      </view>
      <text class="cd-title">{{item.title}}</text>
      <text class="cd-text">{{item.content}}</text>
      <image wx:if="{{item.image}}" class="cd-image" src="{{item.image}}" mode="aspectFill" />
      <view class="cd-footer">
        <text wx:if="{{item.tag}}" class="cd-tag"># {{item.tag}}</text>
        <view class="cd-actions">
          <view class="cd-action"><text>◯</text><text>{{item.comments}}</text></view>
          <view hover-class="tap-card" hover-stay-time="80" class="cd-action {{item.liked ? 'liked' : ''}}" catchtap="toggleLike" data-id="{{item.id}}">
            <text>{{item.liked ? '♥' : '♡'}}</text><text>{{item.likes}}</text>
          </view>
        </view>
      </view>
    </view>

    <view hover-class="tap" hover-stay-time="80" class="cd-more" wx:if="{{hasMore}}" bindtap="loadMore">{{loadingMore ? '加载中…' : '加载更多'}}</view>
    <view class="cd-more cd-more-end" wx:elif="{{posts.length}}">已经到底啦</view>
  </block>

  <ui-popup
    id="ui-popup"
    visible="{{uiPopup.visible}}"
    mode="{{uiPopup.mode}}"
    tone="{{uiPopup.tone}}"
    title="{{uiPopup.title}}"
    message="{{uiPopup.message}}"
    editable="{{uiPopup.editable}}"
    placeholder="{{uiPopup.placeholder}}"
    inputValue="{{uiPopup.inputValue}}"
    actions="{{uiPopup.actions}}"
    show-cancel="{{uiPopup.showCancel}}"
    cancel-text="{{uiPopup.cancelText}}"
    confirm-text="{{uiPopup.confirmText}}"
    bindconfirm="onPopupConfirm"
    bindcancel="onPopupCancel"
    bindaction="onPopupAction"
    bindinput="onPopupInput"
    bindclose="onPopupClose"
  />
</view>
<!-- 全局悬浮宠物 -->
<pet-float bottom="200" />
