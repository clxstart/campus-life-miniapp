.cd-page {
  min-height: 100vh;
  background: #f6f8fb;
  padding-bottom: 40rpx;
}

/* ===== 导航条：与其他页面保持一致 ===== */
.cd-nav {
  background: #ffffff;
}

.cd-nav-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-left: 20rpx;
}

.cd-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #21303d;
  font-size: 44rpx;
  line-height: 1;
}

.cd-nav-title {
  flex: 1;
  color: #21303d;
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 状态块 ===== */
.cd-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 160rpx 40rpx;
  color: #828b93;
  font-size: 26rpx;
}

.cd-state-title {
  font-size: 28rpx;
}

.cd-state-btn {
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5b9df0 0%, #7eb6f6 100%);
  color: #ffffff;
  font-size: 26rpx;
}

/* ===== 圈子头部 ===== */
.cd-header {
  position: relative;
  margin: 20rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(80, 125, 175, 0.12);
}

.cd-cover-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cd-cover-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(28, 58, 92, 0.86) 0%, rgba(45, 96, 148, 0.72) 60%, rgba(80, 125, 175, 0.6) 100%);
}

.cd-header-copy {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 32rpx 28rpx 76rpx;
}

.cd-header-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cd-name {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 600;
}

.cd-category {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  color: #ffffff;
  font-size: 20rpx;
}

.cd-desc {
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  line-height: 1.5;
}

.cd-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.cd-dot {
  color: rgba(255, 255, 255, 0.4);
}

.cd-join {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2d6094;
  font-size: 24rpx;
  font-weight: 600;
}

.cd-join.joined {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-weight: 400;
}

/* ===== 工具条 ===== */
.cd-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx 4rpx;
}

.cd-toolbar-actions{display:flex;align-items:center;gap:12rpx}
.cd-chat-entry{position:relative;padding:12rpx 24rpx;border-radius:999rpx;background:#eaf3ff;color:#3476f6;font-size:24rpx}
.cd-chat-badge{position:absolute;top:-12rpx;right:-10rpx;min-width:28rpx;height:28rpx;padding:0 6rpx;border-radius:999rpx;background:#ff6475;color:#fff;font-size:18rpx;line-height:28rpx;text-align:center}

.cd-section {
  color: #21303d;
  font-size: 30rpx;
  font-weight: 600;
}

.cd-compose {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5b9df0 0%, #7eb6f6 100%);
  color: #ffffff;
  font-size: 24rpx;
}

/* ===== 帖子卡片 ===== */
.cd-card {
  margin: 18rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(80, 125, 175, 0.09);
}

.cd-author {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cd-avatar {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eef3f9;
}

.cd-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #dceaff;
  color: #4d91e7;
  font-size: 26rpx;
}

.cd-author-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cd-author-name {
  color: #21303d;
  font-size: 26rpx;
  font-weight: 600;
}

.cd-author-time {
  color: #a2abb3;
  font-size: 21rpx;
}

.cd-title {
  display: block;
  margin-top: 18rpx;
  color: #21303d;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.cd-text {
  display: block;
  margin-top: 10rpx;
  color: #4a5764;
  font-size: 26rpx;
  line-height: 1.6;
}

.cd-image {
  width: 100%;
  height: 320rpx;
  margin-top: 16rpx;
  border-radius: 18rpx;
  background: #eef3f9;
}

.cd-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.cd-tag {
  color: #4d91e7;
  font-size: 22rpx;
}

.cd-actions {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-left: auto;
}

.cd-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #828b93;
  font-size: 22rpx;
}

.cd-action.liked {
  color: #ff6475;
}

/* ===== 状态与更多 ===== */
.cd-loading,
.cd-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 100rpx 40rpx;
  color: #828b93;
  font-size: 25rpx;
}

.cd-empty-icon {
  color: #cfd6dd;
  font-size: 56rpx;
}

.cd-more {
  margin: 28rpx 24rpx 0;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #4d91e7;
  font-size: 26rpx;
  text-align: center;
}

.cd-more-end {
  color: #a2abb3;
  font-size: 23rpx;
}
