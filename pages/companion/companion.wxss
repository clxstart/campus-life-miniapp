@import "../../styles/theme.wxss";
@import "../../styles/common.wxss";

/* 聊天页固定视口，只有消息区滚动 */
.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0 var(--sp-page);
  box-sizing: border-box;
  overflow: hidden;
}

/* ===== 顶部 ===== */
.chat-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: var(--bw) solid var(--c-line);
  flex-shrink: 0;
}

.chat-head-info { min-width: 0; }

.chat-head-name {
  display: block;
  font-size: var(--fs-card-title);
  font-weight: 600;
  color: var(--c-text);
}

/* AI 身份必须明确 */
.chat-head-role {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--c-text-sub);
}

/* ===== 消息区 ===== */
.chat-body {
  flex: 1;
  min-height: 0;
  padding: 18rpx 0;
  box-sizing: border-box;
}

.chat-empty {
  padding: 60rpx 0;
  text-align: center;
}

/* ===== 快捷提问 ===== */
.chat-quick {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 0;
  overflow-x: auto;
  flex-shrink: 0;
  border-top: var(--bw) solid var(--c-line);
}

.chat-quick-item {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: var(--c-card);
  border: var(--bw) solid var(--c-line);
  border-radius: var(--radius-pill);
}

.chat-quick-text {
  font-size: 24rpx;
  color: var(--c-primary);
}

/* ===== 输入区 ===== */
.chat-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 16rpx;
  flex-shrink: 0;
}

.chat-input-box {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 28rpx;
  background: var(--c-card);
  border: var(--bw) solid var(--c-line);
  border-radius: var(--radius-pill);
  font-size: var(--fs-body);
  color: var(--c-text);
}

.chat-send {
  flex-shrink: 0;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 36rpx;
  border-radius: var(--radius-pill);
  background: var(--c-primary);
  color: var(--c-on-primary);
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
}

.chat-send--off {
  opacity: 0.4;
}
