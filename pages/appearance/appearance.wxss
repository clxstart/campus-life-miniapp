@import "../../styles/theme.wxss";
@import "../../styles/common.wxss";

.appear {
  display: flex;
  flex-direction: column;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.appear-head {
  padding: 20rpx 0 22rpx;
}

.appear-sub {
  display: block;
  margin-top: 8rpx;
}

/* ===== 动作面板 ===== */
.appear-panel {
  margin-top: var(--sp-gap);
  background: var(--c-card);
  border: var(--bw) solid var(--c-line);
  border-radius: var(--radius-card);
  padding: var(--sp-card);
}

.action-label {
  display: block;
  margin-bottom: 16rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.action-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 4rpx 12rpx;
  border: var(--bw) solid var(--c-line);
  border-radius: 20rpx;
  background: var(--c-bg);
  transition: border-color 140ms ease, background 140ms ease;
}

.action-icon {
  font-size: 28rpx;
  color: var(--c-primary);
  line-height: 1.2;
}

.action-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.action-btn.cp-selected .action-name {
  color: var(--c-primary);
  font-weight: 600;
}

.action-check {
  position: absolute;
  right: 6rpx;
  top: 2rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--c-primary);
}

.appear-tip {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  background: var(--c-bg);
  border-radius: 16rpx;
  text-align: center;
}
