<page-meta page-style="background:#F7F9FC;" />
<view class="publish-page">
  <view class="publish-navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="publish-navbar-row" style="height: {{navBarHeight}}px; padding-right: {{capsuleReservedRight}}px;">
      <view class="cp-back" catchtap="goBack">‹</view>
      <text class="publish-title">发帖</text>
    </view>
  </view>
  <offline-banner />

  <view class="publish-content">
    <view wx:if="{{error}}" class="cp-error">{{error}}</view>

    <!-- 圈子标识：明确发到哪里，避免发错圈 -->
    <view wx:if="{{circle}}" class="cp-circle">
      <image wx:if="{{circle.cover}}" class="cp-circle-cover" src="{{circle.cover}}" mode="aspectFill" />
      <view class="cp-circle-copy">
        <text class="cp-circle-name">发布到「{{circle.name}}」</text>
        <text class="cp-circle-note">{{circle.category}} · {{circle.memberCount}} 成员</text>
      </view>
    </view>

    <view class="form-card">
      <input
        class="title-input"
        maxlength="28"
        value="{{title}}"
        placeholder="给内容起个标题"
        placeholder-class="form-placeholder"
        bindinput="inputTitle"
      />
      <view class="form-divider"></view>
      <textarea
        class="content-input"
        maxlength="500"
        value="{{content}}"
        placeholder="说说发生了什么，真实具体的分享更容易遇见同好…"
        placeholder-class="form-placeholder"
        bindinput="inputContent"
      />
      <text class="content-count">{{content.length}} / 500</text>

      <view class="media-grid">
        <view wx:for="{{media}}" wx:key="*this" class="media-item">
          <image src="{{item}}" mode="aspectFill" />
          <view class="media-remove" catchtap="removeMedia" data-index="{{index}}">×</view>
        </view>
        <view class="media-add" wx:if="{{media.length < 6}}" bindtap="chooseMedia">
          <text class="camera-icon">⌁</text>
          <text>添加图片</text>
          <text>{{media.length}} / 6</text>
        </view>
      </view>
    </view>

    <view class="setting-card">
      <view class="setting-row" bindtap="chooseLocation">
        <view class="setting-left">
          <view class="setting-icon blue-setting">⌖</view>
          <view class="setting-copy">
            <text class="setting-title">所在位置</text>
            <text class="setting-value">{{location || '不显示位置'}}</text>
          </view>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      <view class="setting-row">
        <view class="setting-left">
          <view class="setting-icon green-setting">校</view>
          <view class="setting-copy">
            <text class="setting-title">仅本校可见</text>
            <text class="setting-value">保护校园社区氛围</text>
          </view>
        </view>
        <switch checked="{{visibleToSchool}}" color="#3476F6" bindchange="toggleVisible" />
      </view>
    </view>

    <button class="submit-button" loading="{{submitting}}" disabled="{{submitting || !circle}}" bindtap="submit">
      {{submitting ? '正在发布…' : '发布到圈子'}}
    </button>
  </view>

  <ui-popup
    id="ui-popup"
    visible="{{uiPopup.visible}}"
    mode="{{uiPopup.mode}}"
    tone="{{uiPopup.tone}}"
    title="{{uiPopup.title}}"
    message="{{uiPopup.message}}"
    editable="{{uiPopup.editable}}"
    placeholder="{{uiPopup.placeholder}}"
    inputValue="{{uiPopup.inputValue}}"
    actions="{{uiPopup.actions}}"
    show-cancel="{{uiPopup.showCancel}}"
    cancel-text="{{uiPopup.cancelText}}"
    confirm-text="{{uiPopup.confirmText}}"
    bindconfirm="onPopupConfirm"
    bindcancel="onPopupCancel"
    bindaction="onPopupAction"
    bindinput="onPopupInput"
    bindclose="onPopupClose"
  />
</view>
