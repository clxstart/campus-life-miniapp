/* 复用发布页的整套表单/卡片/按钮样式，保证两个发帖入口观感一致 */
@import "../publish/publish.wxss";

/* 导航返回键：发布页没有返回键，这里补一个 */
.cp-back {
  flex: none;
  padding: 0 14rpx;
  margin-right: 12rpx;
  font-size: 44rpx;
  line-height: 1;
  color: #1a2330;
}

/* 圈子标识卡：明确发帖目标 */
.cp-circle {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e8f1ff 0%, #eef7f3 100%);
}

.cp-circle-cover {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: #dbe7f5;
}

.cp-circle-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cp-circle-name {
  color: #21303d;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cp-circle-note {
  color: #7d8a96;
  font-size: 21rpx;
}

.cp-error {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fdecec;
  color: #c76156;
  font-size: 25rpx;
  text-align: center;
}
