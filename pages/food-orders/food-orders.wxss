.orders-page{min-height:100vh;background:#f6f8fb;padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}
.nav{display:flex;align-items:center;padding-left:34rpx;background:#f6f8fb}
.nav-title{flex:1;text-align:center;font-size:31rpx;font-weight:700;color:#18232d}
.back{width:56rpx;color:#56645b;font-size:42rpx}
.nav-action{width:70rpx;text-align:right;color:#34764b;font-size:21rpx}
.order-list{padding:18rpx 28rpx}
.order-card{position:relative;margin-bottom:16rpx;padding:24rpx 48rpx 22rpx 22rpx;border:1rpx solid #e5ebe6;border-radius:16rpx;background:#fff}
.order-top,.order-foot{display:flex;align-items:center;justify-content:space-between;gap:14rpx}
.shop-name{font-size:27rpx;font-weight:700;color:#24342b}
.status{flex:none;padding:5rpx 12rpx;border-radius:8rpx;font-size:19rpx}
.status.active{background:#eaf5ec;color:#2f7046}
.status.done{background:#edf3ff;color:#496caa}
.status.closed{background:#f0f2f0;color:#727d75}
.items{display:block;margin-top:17rpx;color:#65736a;font-size:22rpx;line-height:1.6}
.order-foot{margin-top:17rpx;border-top:1rpx solid #eef1ee;padding-top:14rpx}
.time{color:#98a29b;font-size:19rpx}
.amount{font-size:25rpx;font-weight:700;color:#24342b}
.arrow{position:absolute;right:16rpx;top:50%;transform:translateY(-50%);color:#aab5ac;font-size:38rpx}
.state{padding:150rpx 36rpx 60rpx;text-align:center;color:#7c8980;font-size:22rpx}
.state-title{display:block;margin-bottom:12rpx;color:#26362c;font-size:29rpx;font-weight:700}
.state-copy{display:block;margin-top:6rpx}
.retry,.browse{margin:24rpx auto 0;color:#34764b}
.browse{width:220rpx;border:0;border-radius:10rpx;background:#34764b;color:#fff;font-size:23rpx}
