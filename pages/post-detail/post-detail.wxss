.detail-page{min-height:100vh;background:#fff;color:#18212b;box-sizing:border-box}
/* 自定义导航：与社区页同款，返回键 + 标题 */
.nav{box-sizing:content-box;display:flex;align-items:center;padding:0 32rpx;background:#fff
  box-shadow: 0 2rpx 0 #eef1f4; /* 白导航压在浅底上，加分隔线否则边界看不清 */
}
.nav-title{font-size:36rpx;font-weight:700}
.back{flex:none;margin-right:20rpx;padding:0 10rpx;font-size:40rpx;font-weight:400;color:#1a2330}
.detail-body{padding:24rpx 32rpx 60rpx}
/* 狐友同款作者行：88rpx 大头像 + 粗黑昵称 + 小灰时间 + 右侧关注胶囊 */
.author-row{display:flex;align-items:center}
.avatar{width:88rpx;height:88rpx;border-radius:50%;background:#dcecff;flex:none}
.fallback{display:flex;align-items:center;justify-content:center;background:#e6f5ef;color:#3a9b76;font-weight:700;font-size:32rpx}
.author-meta{display:flex;flex-direction:column;margin-left:20rpx;flex:1;min-width:0}
.nickname{font-size:30rpx;font-weight:700;color:#1a2330}
.time{margin-top:6rpx;color:#a2aab2;font-size:22rpx}
/* 关注胶囊：与社区页一致，已关注变灰 */
.follow{flex:none;margin:0;padding:0 22rpx;height:52rpx;line-height:50rpx;border:1rpx solid #9ec6f0;border-radius:26rpx;background:#fff;color:#378be7;font-size:22rpx;font-weight:500}
.follow:after{border:0}
.follow.following{border-color:#dfe3e8;color:#9aa2aa;background:transparent}
/* 正文：标题大字近黑，正文 29rpx 行高松，接近纯黑 */
.title{margin-top:20rpx;font-size:32rpx;line-height:46rpx;font-weight:700;color:#1a2330}
.content{margin-top:10rpx;color:#2b3540;font-size:29rpx;line-height:46rpx}
/* 单图固定 3:2 裁切，小圆角 */
.post-image{display:block;width:100%;height:400rpx;margin-top:16rpx;border-radius:12rpx;background:#eef1f5}
/* 话题蓝字内联 */
.topic{display:inline-block;margin-top:16rpx;color:#378be7;font-size:24rpx;font-weight:500}
.location{display:block;margin-top:8rpx;color:#99a3ad;font-size:21rpx}
/* 评论：细分割线 + 近黑粗体头 */
.comments-head{margin-top:34rpx;padding-top:24rpx;border-top:1rpx solid #f0f1f3;color:#1a2330;font-size:28rpx;font-weight:700}
.tip{padding:40rpx 0;color:#a5adb5;font-size:23rpx;text-align:center}
.page-tip{padding-top:200rpx}
/* 狐友式评论项：小头像 + 粗黑昵称 + 近黑内容 + 小灰时间 */
/* 评论条目：左头像 → 用户名 / 内容 / 时间·回复 → 右侧点赞
   参考主流社区（贴吧/B站）的评论区排版 */
.comment-item{display:flex;align-items:flex-start;padding:24rpx 0;border-bottom:1rpx solid #f0f1f3}
.comment-avatar{width:64rpx;height:64rpx;border-radius:50%;background:#dcecff;flex:none;display:flex;align-items:center;justify-content:center;color:#3a9b76;font-weight:700;font-size:26rpx}
.comment-main{flex:1;min-width:0;margin-left:16rpx}
.comment-name{color:#8b939b;font-size:23rpx}
.comment-text{display:block;margin-top:6rpx;color:#1a2330;font-size:29rpx;line-height:42rpx;word-break:break-all}
/* 时间 · 回复 同一行 */
.comment-foot{display:flex;align-items:center;margin-top:8rpx}
.comment-time{color:#a8b0b8;font-size:21rpx}
.comment-dot{margin:0 8rpx;color:#c4cace;font-size:21rpx}
.comment-reply{color:#8b939b;font-size:21rpx}
.comment-reply:active{color:#2F6555}
/* 右侧点赞：空心/实心切换，数字跟在后面 */
.comment-like{flex:none;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;min-width:56rpx;padding-left:12rpx}
.comment-like-icon{color:#b9c1c7;font-size:30rpx;line-height:1.2}
.comment-like-num{margin-top:2rpx;color:#a8b0b8;font-size:20rpx}
.comment-like.liked .comment-like-icon{color:#e2564d}
.comment-like.liked .comment-like-num{color:#e2564d}
.bottom-pad{height:140rpx}
/* 底部输入条：白底 + 细顶边，圆角输入 + 蓝/灰发送 + 点赞胶囊 */
.input-bar{position:fixed;left:0;right:0;bottom:0;display:flex;align-items:center;gap:16rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #f0f1f3}
.bar-input{flex:1;height:72rpx;padding:0 26rpx;box-sizing:border-box;border-radius:36rpx;background:#f2f4f7;font-size:24rpx}
.bar-placeholder{color:#a8b0b8}
.bar-send{flex:none;padding:0 28rpx;height:72rpx;line-height:72rpx;border-radius:36rpx;background:#eef1f5;color:#9aa4ae;font-size:24rpx;font-weight:600}
.bar-send.ready{background:#378be7;color:#fff}
.bar-like{flex:none;padding:0 24rpx;height:72rpx;line-height:72rpx;border-radius:36rpx;background:#f2f4f7;color:#8a949e;font-size:24rpx;font-weight:600}
.bar-fav{flex:none;padding:0 22rpx;height:72rpx;line-height:72rpx;border-radius:36rpx;background:#f2f4f7;color:#8a949e;font-size:24rpx;font-weight:600}
.bar-fav.favored{background:#fdf3dd;color:#c08a1d}
.bar-like.liked{background:#fdeef1;color:#e05a75}
