.discover-page {
  min-height: 100vh;
  background: #f6f8fb;
}

.discover-navbar {
  background: rgba(246, 248, 251, 0.97);
}

.discover-navbar-row {
  padding-left: 38rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.page-title {
  flex: none;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: #111820;
}

.discover-search {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  color: #9aa1a8;
  font-size: 18rpx;
}

.discover-search image {
  width: 23rpx;
  height: 23rpx;
  margin-right: 9rpx;
}

.discover-search text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.discover-content {
  padding: 13rpx 32rpx calc(128rpx + env(safe-area-inset-bottom));
}

/* 顶部轮播：高度 = 卡片 178 + 底部指示点区 */
.hero-swiper {
  height: 206rpx;
}

.swiper-item {
  padding-bottom: 24rpx;
}

.discover-hero {
  position: relative;
  height: 178rpx;
  padding: 31rpx 28rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #d8ebff 0%, #e8f8f1 58%, #fff0f5 100%);
  box-shadow: 0 8rpx 24rpx rgba(80, 125, 175, 0.09);
}

/* 主题配色：课表蓝、校历绿、活动粉 */
.discover-hero.blue {
  background: linear-gradient(135deg, #d8ebff 0%, #dcefff 62%, #eaf3ff 100%);
}

.discover-hero.green {
  background: linear-gradient(135deg, #e0f6e9 0%, #e8f8f1 58%, #effbef 100%);
}

.discover-hero.pink {
  background: linear-gradient(135deg, #ffe9f2 0%, #fff0e9 58%, #f3ecff 100%);
}

.hero-copy {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
}

.hero-eyebrow {
  font-size: 13rpx;
  line-height: 19rpx;
  letter-spacing: 3rpx;
  font-weight: 600;
  color: #4d91e7;
}

.hero-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  line-height: 43rpx;
  font-weight: 700;
  color: #15334e;
}

.hero-subtitle {
  margin-top: 7rpx;
  font-size: 17rpx;
  line-height: 25rpx;
  color: #688092;
}

/* 右侧圆徽：课表 / 校历 / 活动 */
.hero-badge {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
  background: linear-gradient(145deg, #69adff, #3b7ff0);
  box-shadow: 0 8rpx 18rpx rgba(56, 123, 228, 0.24);
}

.discover-hero.green .hero-badge {
  background: linear-gradient(145deg, #6fd3a0, #34a874);
  box-shadow: 0 8rpx 18rpx rgba(52, 168, 116, 0.24);
}

.discover-hero.pink .hero-badge {
  background: linear-gradient(145deg, #ff9fbe, #f0608f);
  box-shadow: 0 8rpx 18rpx rgba(240, 96, 143, 0.26);
}

.hero-bubble {
  position: absolute;
  z-index: 2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(72, 132, 196, 0.18);
}

.bubble-one {
  right: 71rpx;
  top: 34rpx;
  width: 62rpx;
  height: 62rpx;
  background: #58a2f6;
  font-size: 30rpx;
}

.bubble-two {
  right: 18rpx;
  top: 91rpx;
  width: 50rpx;
  height: 50rpx;
  background: #65c794;
  font-size: 24rpx;
}

.topic-heading {
  margin-top: 27rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 600;
  color: #111820;
}

.topic-more {
  font-size: 17rpx;
  font-weight: 400;
  color: #989fa5;
}

.topic-scroll {
  width: calc(100% + 32rpx);
  margin-top: 13rpx;
}

.topic-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 32rpx;
}

.topic-card {
  position: relative;
  flex: none;
  width: 212rpx;
  height: 126rpx;
  overflow: hidden;
  border-radius: 17rpx;
}

.topic-card image,
.topic-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.topic-mask {
  background: linear-gradient(180deg, rgba(8, 24, 36, 0.03), rgba(8, 24, 36, 0.58));
}

.topic-name,
.topic-count {
  position: absolute;
  z-index: 2;
  left: 14rpx;
  color: #ffffff;
}

.topic-name {
  bottom: 30rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 600;
}

.topic-count {
  bottom: 10rpx;
  font-size: 13rpx;
  line-height: 18rpx;
  opacity: 0.85;
}

.category-tabs {
  height: 66rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 34rpx;
  border-bottom: 1rpx solid #e9edf1;
}

.category-tab {
  position: relative;
  height: 66rpx;
  padding-top: 18rpx;
  color: #8c939a;
  font-size: 21rpx;
  line-height: 29rpx;
}

.category-tab.selected {
  color: #16212c;
  font-weight: 600;
}

.category-tab.selected::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 2rpx;
  width: 24rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: #3476f6;
  transform: translateX(-50%);
}

.feed-loading,
.feed-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #9aa1a8;
  font-size: 19rpx;
}

.feed-empty {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.empty-icon {
  font-size: 50rpx;
  color: #b7c8db;
}

.feed-card {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 18rpx rgba(47, 70, 91, 0.055);
}

.author-row {
  display: flex;
  align-items: center;
}

.author-avatar {
  flex: none;
  width: 57rpx;
  height: 57rpx;
  border-radius: 50%;
  background: #e5f0ff;
}

.text-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
}

.author-copy {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  display: flex;
  flex-direction: column;
}

.author-name-line {
  display: flex;
  align-items: center;
}

.author-name {
  font-size: 20rpx;
  line-height: 27rpx;
  font-weight: 600;
  color: #17212a;
}

.author-badge {
  margin-left: 8rpx;
  padding: 2rpx 7rpx;
  border-radius: 7rpx;
  background: #edf5ff;
  color: #4d8ee4;
  font-size: 12rpx;
  line-height: 18rpx;
}

.author-time {
  margin-top: 2rpx;
  font-size: 14rpx;
  line-height: 20rpx;
  color: #9aa1a8;
}

.follow-button {
  flex: none;
  min-width: 66rpx;
  padding: 5rpx 11rpx;
  border-radius: 15rpx;
  border: 1rpx solid #4a8ff1;
  color: #3476f6;
  font-size: 15rpx;
  line-height: 21rpx;
  text-align: center;
}

.follow-button.followed {
  border-color: transparent;
  background: #f0f3f6;
  color: #8a9299;
}

.feed-title {
  display: block;
  margin-top: 17rpx;
  font-size: 24rpx;
  line-height: 33rpx;
  font-weight: 600;
  color: #131c25;
}

.feed-text {
  display: block;
  margin-top: 7rpx;
  font-size: 18rpx;
  line-height: 29rpx;
  color: #606a73;
}

.feed-image {
  display: block;
  width: 100%;
  height: 360rpx;
  margin-top: 15rpx;
  border-radius: 16rpx;
  background: #edf2f6;
}

.feed-footer {
  height: 37rpx;
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feed-tag {
  padding: 4rpx 10rpx;
  border-radius: 11rpx;
  background: #edf5ff;
  color: #4e8fe6;
  font-size: 14rpx;
  line-height: 20rpx;
}

.feed-actions,
.feed-action {
  display: flex;
  align-items: center;
}

.feed-actions {
  gap: 24rpx;
}

.feed-action {
  gap: 5rpx;
  color: #828b93;
  font-size: 17rpx;
}

.feed-action text:first-child {
  font-size: 23rpx;
}

.feed-action.liked {
  color: #ff6475;
}

/* ===== 圈子卡片：沿用 feed-card 的圆角/阴影/留白语言 ===== */
.circle-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(80, 125, 175, 0.09);
}

.circle-last-message{max-width:360rpx;margin-top:6rpx;color:#6c7b88;font-size:21rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.circle-unread-badge{position:absolute;top:18rpx;right:18rpx;min-width:30rpx;height:30rpx;padding:0 7rpx;border-radius:999rpx;background:#ff6475;color:#fff;font-size:18rpx;line-height:30rpx;text-align:center}

.circle-cover {
  flex: none;
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: #eef3f9;
}

.circle-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.circle-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.circle-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #21303d;
}

.circle-category {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #4d91e7;
  font-size: 19rpx;
}

.circle-desc {
  color: #828b93;
  font-size: 23rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.circle-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #a2abb3;
  font-size: 21rpx;
}

.circle-dot {
  color: #cfd6dd;
}

.circle-join {
  flex: none;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5b9df0 0%, #7eb6f6 100%);
  color: #ffffff;
  font-size: 22rpx;
}

.circle-join.joined {
  background: #eef3f9;
  color: #8b959e;
}

/* 本校/全部切换：分段控件 */
.scope-switch{display:flex;margin-left:auto;margin-right:16rpx;padding:4rpx;border-radius:22rpx;background:#f0f2f4}
.scope-opt{padding:8rpx 20rpx;border-radius:18rpx;color:#737e88;font-size:21rpx}
.scope-opt.on{background:#fff;color:#3476f6;font-weight:600;box-shadow:0 2rpx 6rpx rgba(36,62,96,.08)}
