<view class="food-page order-page">
<view class="nav" style="padding-top:{{statusBarHeight}}px;height:{{navBarHeight}}px;padding-right:{{capsuleReservedRight}}px"><view class="back" catchtap="goBack">‹</view><view class="nav-title">确认订单</view></view>
  <offline-banner />
  <view wx:if="{{loading}}" class="state">正在确认餐食与配送信息…</view>
  <view wx:elif="{{error}}" class="state"><text class="state-title">{{error}}</text><view bindtap="goBack">返回选购</view></view>
  <block wx:else>
    <view class="address-card card" bindtap="chooseAddress"><view class="address-symbol">⌖</view><view class="address-main"><text class="address-eyebrow">送到这里 · 校园配送</text><text class="address-detail title">{{address?address.detail:'请选择收货地址'}}</text><text class="address-contact">{{address?(address.contact+' '+(address.phone||'')):'添加宿舍或教学楼地址'}}</text></view><text class="address-arrow">›</text></view>
    <view class="arrival"><text class="arrival-dot"></text>预计 {{shop.deliveryTime}} 分钟送达楼下</view>
    <view class="order-card card"><view class="order-heading title">{{shop.name}}<text class="muted">共{{items.length}}种餐食</text></view><view wx:for="{{items}}" wx:key="goodsId" class="order-item"><image class="order-image" src="{{item.image}}" mode="aspectFill"/><view class="order-item-copy"><text class="item-name title">{{item.name}}</text><text class="muted">¥{{item.priceText}} × {{item.count}}</text></view><text class="item-total">¥{{item.lineTotal}}</text></view><view class="fee-row"><text>商品合计</text><text>¥{{fees.subtotal}}</text></view><view class="fee-row"><text>打包费</text><text>¥{{fees.packing}}</text></view><view class="fee-row"><text>配送费</text><text>¥{{fees.delivery}}</text></view><view wx:if="{{fees.discount!=='0.00'}}" class="fee-row discount-row"><text>店铺满减 · {{shop.discount}}</text><text>−¥{{fees.discount}}</text></view><view class="total-row"><text>合计</text><text class="price">¥{{fees.total}}</text></view></view>
    <view class="remark-card card"><view class="title remark-title">订单备注<text class="muted">{{remark.length}}/200</text></view><textarea class="remark-input" value="{{remark}}" maxlength="200" placeholder="口味、餐具或配送需要，告诉店家吧" placeholder-class="remark-placeholder" bindinput="editRemark" disabled="{{submitting || submitted}}"/></view>
    <view class="order-tip">请留意配送联系，及时到楼下取餐</view>
    <view class="bottom"><view class="bottom-inner"><view class="bottom-copy"><text class="bottom-price">¥{{fees.total}}</text><text class="bottom-note">含打包费、配送费 · 已扣满减</text></view><button class="primary" loading="{{submitting}}" disabled="{{submitting || submitted || fees.missing!=='0.00'}}" bindtap="submit">{{submitted?'已提交':submitting?'提交中':'提交订单'}}</button></view></view>
  </block>
<ui-popup id="ui-popup" visible="{{uiPopup.visible}}" mode="{{uiPopup.mode}}" tone="{{uiPopup.tone}}" title="{{uiPopup.title}}" message="{{uiPopup.message}}" editable="{{uiPopup.editable}}" placeholder="{{uiPopup.placeholder}}" inputValue="{{uiPopup.inputValue}}" actions="{{uiPopup.actions}}" show-cancel="{{uiPopup.showCancel}}" confirm-text="{{uiPopup.confirmText}}" bindconfirm="onPopupConfirm" bindcancel="onPopupCancel" bindaction="onPopupAction" bindinput="onPopupInput" bindclose="onPopupClose"/>
</view>
<!-- 全局悬浮宠物 -->
<pet-float bottom="200" />
