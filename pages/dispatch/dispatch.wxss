@import "../../styles/theme.wxss";
@import "../../styles/common.wxss";

.dispatch {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.dp-head {
  padding: 20rpx 0 22rpx;
}

.dp-sub {
  display: block;
  margin-top: 8rpx;
}

/* ===== 当前状态 ===== */
.dp-status {
  margin-top: var(--sp-gap);
  padding: var(--sp-card);
  background: var(--c-card);
  border: var(--bw) solid var(--c-line);
  border-radius: var(--radius-card);
}

.dp-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.dp-status-title {
  font-size: var(--fs-card-title);
  font-weight: 600;
  color: var(--c-text);
}

.dp-status-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  line-height: 1.7;
}

.dp-status-tag--running { background: var(--c-soft); color: var(--c-primary); }
.dp-status-tag--claimable { background: var(--c-accent); color: #FFF; }
.dp-status-tag--claimed { background: #EDEAE0; color: var(--c-text-sub); }

.dp-status-hint {
  display: block;
  margin-top: 10rpx;
}

/* ===== 任务列表 ===== */
.dp-list {
  margin-top: var(--sp-gap);
}

.dp-foot {
  display: block;
  text-align: center;
  margin-top: var(--sp-gap);
}
