page{background:#f7f9fb}.activities-page{min-height:100vh;padding-bottom:40rpx;color:#18212b}.nav{box-sizing:content-box;display:flex;align-items:center;padding-left:28rpx;background:#fff
  box-shadow: 0 2rpx 0 #eef1f4; /* 白导航压在浅底上，加分隔线否则边界看不清 */
}.nav-title{font-size:34rpx;font-weight:700}.back{padding:0 12rpx;margin-right:16rpx;font-size:42rpx}.featured-card{position:relative;height:390rpx;margin:22rpx 24rpx;overflow:hidden;border-radius:24rpx;background:#dde9e3;box-shadow:0 10rpx 26rpx rgba(36,62,96,.08)}.featured-card>image{width:100%;height:100%}.featured-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,28,34,.05),rgba(12,28,34,.82))}.featured-copy{position:absolute;left:24rpx;right:24rpx;bottom:62rpx;color:#fff}.featured-badge{display:inline-block;padding:7rpx 12rpx;border-radius:8rpx;background:#f4b55f;color:#513318;font-size:19rpx}.featured-title{display:block;margin-top:12rpx;font-size:36rpx;font-weight:700}.featured-meta{display:block;margin-top:8rpx;font-size:21rpx;opacity:.9}.featured-count{position:absolute;left:24rpx;bottom:20rpx;color:#fff;font-size:19rpx;opacity:.85}.featured-button{position:absolute;right:22rpx;bottom:18rpx;width:120rpx;height:56rpx;line-height:56rpx;padding:0;border-radius:28rpx;background:#fff;color:#3476f6;font-size:22rpx}.featured-button.joined{color:#a3acb3;background:#edf0f2}.activity-list{padding:0 24rpx}.activity-card{display:flex;align-items:center;margin-bottom:18rpx;padding:18rpx;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(36,62,96,.05)}.poster{flex:none;width:156rpx;height:156rpx;border-radius:14rpx;background:#e8eef2}.activity-copy{flex:1;min-width:0;margin-left:18rpx}.activity-title{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:27rpx;font-weight:650}.activity-meta{margin-top:9rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#7d8892;font-size:20rpx}.activity-count{margin-top:12rpx;color:#a0a8b0;font-size:19rpx}.enroll-button{flex:none;width:100rpx;height:58rpx;line-height:58rpx;padding:0;margin-left:10rpx;border-radius:29rpx;background:#3476f6;color:#fff;font-size:21rpx}.enroll-button.joined{background:#edf0f2;color:#a3acb3}.state{text-align:center;padding:180rpx 0;color:#9aa4ad;font-size:24rpx}.state-title{display:block;margin-bottom:10rpx;color:#45515c;font-size:29rpx;font-weight:600}.feature-entry{padding:6rpx 24rpx 2rpx}.feature-entry-title{font-size:28rpx;font-weight:700;margin-bottom:14rpx}.feature-entry-row{display:flex;gap:16rpx}.feature-entry-card{flex:1;min-width:0;display:flex;flex-direction:column;padding:22rpx;border-radius:22rpx;box-shadow:0 8rpx 22rpx rgba(36,62,96,.07)}.feature-entry-card.idol{background:linear-gradient(135deg,#ffe9f2 0%,#fff0e9 58%,#f3ecff 100%)}.feature-entry-card.singer{background:linear-gradient(135deg,#d8ebff 0%,#dcefff 62%,#eaf3ff 100%)}.feature-entry-badge{align-self:flex-start;padding:5rpx 12rpx;border-radius:8rpx;background:rgba(255,255,255,.72);color:#7a5a3a;font-size:18rpx}.feature-entry-name{margin-top:12rpx;font-size:27rpx;font-weight:700;color:#2b3644}.feature-entry-desc{margin-top:8rpx;color:#7d8892;font-size:19rpx;line-height:1.4}.feature-entry-go{margin-top:14rpx;color:#3476f6;font-size:20rpx}

/* 本校/全部切换：分段控件 */
.scope-switch{display:flex;margin-left:auto;margin-right:16rpx;padding:4rpx;border-radius:22rpx;background:#f0f2f4}
.scope-opt{padding:8rpx 20rpx;border-radius:18rpx;color:#737e88;font-size:21rpx}
.scope-opt.on{background:#fff;color:#3476f6;font-weight:600;box-shadow:0 2rpx 6rpx rgba(36,62,96,.08)}

/* 触底加载提示：列表底部一行小字，不抢内容注意力 */
.list-more {
  padding: 32rpx 0 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8A9992;
}
