<page-meta page-style="background:#F7F9FC;" />
<view class="publish-page">
  <view class="publish-navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="publish-navbar-row" style="height: {{navBarHeight}}px; padding-right: {{capsuleReservedRight}}px;">
      <text class="publish-title">发布</text>
      <text hover-class="tap" hover-stay-time="80" class="draft-link" bindtap="openDrafts">草稿箱</text>
    </view>
  </view>
  <offline-banner />

  <view class="publish-content">
    <view class="publish-intro">
      <view>
        <text class="intro-title">分享此刻</text>
        <text class="intro-subtitle">让校园生活多一点连接和惊喜</text>
      </view>
      <view class="intro-mark">✦</view>
    </view>

    <text class="section-label">选择发布类型</text>
    <view class="type-grid">
      <view hover-class="tap-card" hover-stay-time="80"
        wx:for="{{types}}"
        wx:key="key"
        class="type-card {{activeType === index ? 'selected' : ''}}"
        bindtap="chooseType"
        data-index="{{index}}"
      >
        <view class="type-icon" style="background:{{item.color}}">{{item.icon}}</view>
        <text>{{item.label}}</text>
        <text class="type-desc">{{item.desc}}</text>
        <view class="selected-check" wx:if="{{activeType === index}}">✓</view>
      </view>
    </view>

    <view class="form-card">
      <input
        class="title-input"
        maxlength="28"
        value="{{title}}"
        placeholder="{{activeType === 1 ? '物品名称' : activeType === 2 ? '职位名称' : activeType === 3 ? '活动名称' : '给内容起个标题'}}"
        placeholder-class="form-placeholder"
        bindinput="inputTitle"
      />
      <view class="form-divider"></view>
      <textarea
        class="content-input"
        maxlength="500"
        value="{{content}}"
        placeholder="{{activeType === 1 ? '描述成色、来源、交易方式…' : activeType === 2 ? '工作内容、要求、联系方式…' : activeType === 3 ? '活动内容、参与方式、注意事项…' : '说说发生了什么，真实具体的分享更容易遇见同好…'}}"
        placeholder-class="form-placeholder"
        bindinput="inputContent"
      />
      <text class="content-count">{{content.length}} / 500</text>

      <view class="media-grid">
        <view wx:for="{{media}}" wx:key="*this" class="media-item">
          <image src="{{item}}" mode="aspectFill" />
          <view hover-class="tap" hover-stay-time="80" class="media-remove" catchtap="removeMedia" data-index="{{index}}">×</view>
        </view>
        <view class="media-add" wx:if="{{media.length < 6}}" bindtap="chooseMedia">
          <text class="camera-icon">⌁</text>
          <text>添加图片</text>
          <text>{{media.length}} / 6</text>
        </view>
      </view>
    </view>

    <!-- 闲置专用：价格 / 成色 / 分类 -->
    <view class="setting-card" wx:if="{{activeType === 1}}">
      <view class="setting-row">
        <view class="setting-left">
          <view class="setting-icon" style="background:#62C78E">¥</view>
          <view class="setting-copy">
            <text class="setting-title">价格（元）</text>
            <text class="setting-value">必填，填数字</text>
          </view>
        </view>
        <input
          class="setting-input"
          type="digit"
          maxlength="8"
          value="{{price}}"
          placeholder="如 45"
          placeholder-class="form-placeholder"
          bindinput="inputPrice"
        />
      </view>
      <view hover-class="tap-card" hover-stay-time="80" class="setting-row" bindtap="chooseCondition">
        <view class="setting-left">
          <view class="setting-icon" style="background:#F0B24E">◐</view>
          <view class="setting-copy">
            <text class="setting-title">成色</text>
            <text class="setting-value">{{conditionLevel}}</text>
          </view>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      <view hover-class="tap-card" hover-stay-time="80" class="setting-row" bindtap="chooseCategory">
        <view class="setting-left">
          <view class="setting-icon" style="background:#4E96F2">▤</view>
          <view class="setting-copy">
            <text class="setting-title">分类</text>
            <text class="setting-value">{{category}}</text>
          </view>
        </view>
        <text class="setting-arrow">›</text>
      </view>
    </view>

    <!-- 兼职专用：日薪与结算方式 -->
    <view class="setting-card" wx:if="{{activeType === 2}}">
      <view class="setting-row">
        <view class="setting-left">
          <view class="setting-icon" style="background:#F0B24E">¥</view>
          <view class="setting-copy">
            <text class="setting-title">日薪（元）</text>
            <text class="setting-value">必填，填数字</text>
          </view>
        </view>
        <input
          class="setting-input"
          type="number"
          maxlength="6"
          value="{{daySalary}}"
          placeholder="如 120"
          placeholder-class="form-placeholder"
          bindinput="inputDaySalary"
        />
      </view>
      <view hover-class="tap-card" hover-stay-time="80" class="setting-row" bindtap="chooseSettle">
        <view class="setting-left">
          <view class="setting-icon" style="background:#62C78E">⇄</view>
          <view class="setting-copy">
            <text class="setting-title">结算方式</text>
            <text class="setting-value">{{settle}}</text>
          </view>
        </view>
        <text class="setting-arrow">›</text>
      </view>
    </view>

    <!-- 兼职与活动专用：时间说明 -->
    <view class="setting-card" wx:if="{{activeType === 2 || activeType === 3}}">
      <view class="setting-row">
        <view class="setting-left">
          <view class="setting-icon" style="background:#EF8EAD">◷</view>
          <view class="setting-copy">
            <text class="setting-title">时间说明</text>
            <text class="setting-value">{{activeType === 2 ? '如 每周一三五 14:00-17:00' : '如 周六 15:00'}}</text>
          </view>
        </view>
        <input
          class="setting-input wide"
          maxlength="32"
          value="{{timeDesc}}"
          placeholder="选填"
          placeholder-class="form-placeholder"
          bindinput="inputTimeDesc"
        />
      </view>
    </view>

    <view class="setting-card">
      <view hover-class="tap-card" hover-stay-time="80" class="setting-row" bindtap="chooseLocation">
        <view class="setting-left">
          <view class="setting-icon blue-setting">⌖</view>
          <view class="setting-copy">
            <text class="setting-title">所在位置</text>
            <text class="setting-value">{{location || '不显示位置'}}</text>
          </view>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      <view class="setting-row" wx:if="{{activeType === 0 || activeType === 1}}">
        <view class="setting-left">
          <view class="setting-icon green-setting">校</view>
          <view class="setting-copy">
            <text class="setting-title">仅本校可见</text>
            <text class="setting-value">保护校园社区氛围</text>
          </view>
        </view>
        <switch checked="{{visibleToSchool}}" color="#3476F6" bindchange="toggleVisible" />
      </view>
    </view>

    <button hover-class="tap-btn" hover-stay-time="80" class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitPost">
      {{submitting ? '正在发布…' : (activeType === 1 ? '上架到二手市场' : activeType === 2 ? '发布兼职' : activeType === 3 ? '创建活动' : '确认发布')}}
    </button>
  </view>
  <bottom-nav active="publish" />

  <ui-popup
    id="ui-popup"
    visible="{{uiPopup.visible}}"
    mode="{{uiPopup.mode}}"
    tone="{{uiPopup.tone}}"
    title="{{uiPopup.title}}"
    message="{{uiPopup.message}}"
    editable="{{uiPopup.editable}}"
    placeholder="{{uiPopup.placeholder}}"
    inputValue="{{uiPopup.inputValue}}"
    actions="{{uiPopup.actions}}"
    show-cancel="{{uiPopup.showCancel}}"
    cancel-text="{{uiPopup.cancelText}}"
    confirm-text="{{uiPopup.confirmText}}"
    bindconfirm="onPopupConfirm"
    bindcancel="onPopupCancel"
    bindaction="onPopupAction"
    bindinput="onPopupInput"
    bindclose="onPopupClose"
  />
</view>
<!-- 全局悬浮宠物 -->
<pet-float bottom="260" static />
