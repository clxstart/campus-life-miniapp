<!-- 校园首页：学校问候 → 快捷入口 → 校园内容 -->
<nav-bar back="/pages/index/index" />

<view class="cp-page cp-page--flush campus">

  <!-- 顶部：学校 / 校区 / 问候 -->
  <view class="cm-head">
    <text class="cp-hint">{{schoolName}} · {{campusName}}</text>
    <text class="cp-page-title cm-greet">{{greeting}}</text>
  </view>

  <!-- 快捷入口 -->
  <view class="cm-quick">
    <view hover-class="tap-card" hover-stay-time="80"
      wx:for="{{quickEntries}}"
      wx:key="key"
      class="cm-quick-item"
      data-key="{{item.key}}"
      bindtap="onQuick"
    >
      <view class="cm-quick-icon">{{item.icon}}</view>
      <text class="cm-quick-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 校园内容 -->
  <view class="cm-section">
    <view class="cm-section-head">
      <text class="cp-card-title">校园新鲜事</text>
      <text class="cp-hint">共 {{feed.length}} 条</text>
    </view>

    <block wx:if="{{feed.length > 0}}">
      <view hover-class="tap-card" hover-stay-time="80"
        wx:for="{{feed}}"
        wx:key="id"
        class="cp-card cm-feed-item"
        data-id="{{item.id}}"
        bindtap="onOpenFeed"
      >
        <view class="cm-feed-head">
          <text class="cm-feed-tag">{{item.tagName}}</text>
          <text class="cm-feed-title">{{item.title}}</text>
        </view>
        <text class="cm-feed-summary cp-hint">{{item.summary}}</text>
        <view class="cm-feed-foot">
          <text class="cp-hint">{{item.author}}</text>
          <text class="cp-hint">{{item.timeText}}</text>
        </view>
      </view>
    </block>
    <view class="cp-empty" wx:else>
      <text>暂时没有新内容</text>
    </view>
  </view>

  <view style="height:200rpx;"></view>
</view>