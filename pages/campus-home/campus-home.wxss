@import "../../styles/theme.wxss";
@import "../../styles/common.wxss";

.campus {
  padding-bottom: 0;
}

/* ===== 顶部 ===== */
.cm-head {
  padding: 20rpx 0 24rpx;
}

.cm-greet {
  display: block;
  margin-top: 8rpx;
}

/* ===== 快捷入口 ===== */
.cm-quick {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: var(--sp-gap);
}

.cm-quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 8rpx;
  background: var(--c-card);
  border: var(--bw) solid var(--c-line);
  border-radius: 22rpx;
}

.cm-quick-icon {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--c-soft);
  color: var(--c-primary);
  font-size: 28rpx;
}

.cm-quick-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
}

/* ===== 校园内容 ===== */
.cm-section {
  margin-top: var(--sp-gap);
}

.cm-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cm-feed-item {
  display: block;
}

.cm-feed-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cm-feed-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  background: var(--c-soft);
  color: var(--c-primary);
  line-height: 1.7;
}

.cm-feed-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cm-feed-summary {
  display: block;
  margin-top: 8rpx;
}

.cm-feed-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}