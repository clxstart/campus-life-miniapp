.page {
  min-height: 100vh;
  background: #fcfcfc;
}

.custom-navbar {
  width: 100%;
  background: rgba(252, 252, 252, 0.98);
}

.navbar-row {
  width: 100%;
  padding-left: 52rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.school-selector {
  flex: none;
  width: 140rpx;
  display: flex;
  align-items: center;
}

.school-name {
  max-width: 118rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 29rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: #111111;
}

.school-caret {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 9rpx solid #171717;
}

.search-entry {
  flex: 1;
  min-width: 0;
  height: 44rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.search-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 44rpx;
  padding: 0;
  font-size: 21rpx;
  line-height: 44rpx;
  color: #52575c;
}

.search-placeholder {
  color: #91969b;
  font-size: 21rpx;
}

.notification-entry {
  position: relative;
  flex: none;
  width: 40rpx;
  height: 44rpx;
  margin-left: 2rpx;
  margin-right: 8px;
}

.notification-icon {
  width: 40rpx;
  height: 44rpx;
}

.content {
  width: 645rpx;
  margin: 10rpx auto 0;
  padding-bottom: calc(104rpx + env(safe-area-inset-bottom));
}

.hero-card {
  width: 644rpx;
  height: 190rpx;
  overflow: hidden;
  border-radius: 18rpx;
}

.hero-image {
  display: block;
  width: 100%;
  height: 100%;
}

.feature-top-row {
  width: 645rpx;
  height: 258rpx;
  margin-top: 12rpx;
  display: flex;
  gap: 17rpx;
}

.feature-card {
  position: relative;
  overflow: hidden;
  border-radius: 17rpx;
}

.delivery-card {
  flex: none;
  width: 313rpx;
  height: 258rpx;
  background: #dbecfe;
}

.feature-right-column {
  flex: none;
  width: 314rpx;
  display: flex;
  flex-direction: column;
  gap: 17rpx;
}

.market-card {
  width: 314rpx;
  height: 121rpx;
  background: #e4f6de;
}

.forum-card {
  width: 314rpx;
  height: 120rpx;
  background: #e5eeff;
}

.feature-bottom-row {
  width: 645rpx;
  height: 195rpx;
  margin-top: 12rpx;
  display: flex;
  gap: 17rpx;
}

.parttime-card {
  flex: none;
  width: 313rpx;
  height: 195rpx;
  background: #eaf4fe;
}

.event-card {
  flex: none;
  width: 314rpx;
  height: 195rpx;
  background: #fae9ef;
}

.card-copy {
  position: absolute;
  left: 22rpx;
  top: 20rpx;
  z-index: 4;
  display: flex;
  flex-direction: column;
}

.compact-copy {
  left: 22rpx;
  top: 18rpx;
}

.event-copy {
  top: 18rpx;
}

.feature-title {
  display: block;
  font-size: 31rpx;
  line-height: 39rpx;
  font-weight: 600;
  color: #111111;
  white-space: nowrap;
}

.feature-subtitle {
  display: block;
  margin-top: 2rpx;
  font-size: 21rpx;
  line-height: 28rpx;
  font-weight: 400;
  color: #71787e;
  white-space: nowrap;
}

.compact-subtitle {
  max-width: 162rpx;
}

.parttime-subtitle {
  max-width: 195rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.round-arrow {
  position: absolute;
  z-index: 6;
  right: 19rpx;
  top: 21rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 3rpx;
  font-size: 31rpx;
  line-height: 36rpx;
  color: #ffffff;
}

.blue-arrow {
  background: #499af5;
}

.forum-arrow {
  top: 16rpx;
  right: 17rpx;
  background: #79b7f8;
}

.pink-arrow {
  top: 17rpx;
  right: 17rpx;
  background: #f3b5cd;
}

.discount-copy {
  position: absolute;
  left: 22rpx;
  bottom: 19rpx;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.discount-pill {
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
  background: #55c888;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 26rpx;
}

.discount-title {
  margin-top: 4rpx;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 700;
  color: #101010;
  white-space: nowrap;
}

.discount-eta {
  font-size: 18rpx;
  line-height: 24rpx;
  color: #8c9297;
  white-space: nowrap;
}

.food-art {
  position: absolute;
  z-index: 3;
  right: -21rpx;
  bottom: -8rpx;
  width: 207rpx;
  height: 159rpx;
}

.market-art {
  position: absolute;
  z-index: 2;
  right: -10rpx;
  bottom: -13rpx;
  width: 172rpx;
  height: 114rpx;
}

.forum-art {
  position: absolute;
  z-index: 2;
  right: 10rpx;
  bottom: -3rpx;
  width: 145rpx;
  height: 98rpx;
}

.parttime-art {
  position: absolute;
  z-index: 2;
  right: -5rpx;
  bottom: -8rpx;
  width: 178rpx;
  height: 142rpx;
}

.job-tag {
  position: absolute;
  z-index: 5;
  padding: 3rpx 8rpx;
  border-radius: 7rpx;
  background: rgba(64, 155, 230, 0.9);
  color: #ffffff;
  font-size: 13rpx;
  line-height: 18rpx;
  transform: rotate(-7deg);
}

.job-tag-a {
  left: 92rpx;
  bottom: 70rpx;
}

.job-tag-b {
  left: 42rpx;
  bottom: 47rpx;
  color: #57717b;
  background: rgba(255, 255, 255, 0.9);
}

.job-tag-c {
  left: 64rpx;
  bottom: 21rpx;
}

.event-art {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 131rpx;
}

/* 点击反馈：让用户知道这块能点（原来没有任何反馈，看起来像点不动） */
.thesis-card-hover {
  background: #dcf2ed;
}

.thesis-card {
  position: relative;
  width: 645rpx;
  height: 175rpx;
  margin-top: 12rpx;
  padding: 19rpx 21rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #e9f9f6;
}

.thesis-heading {
  position: relative;
  z-index: 4;
  width: 414rpx;
  display: flex;
  flex-direction: column;
}

.thesis-title {
  font-size: 31rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: #111111;
  white-space: nowrap;
}

.thesis-subtitle {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 27rpx;
  color: #747b80;
  white-space: nowrap;
}

.thesis-badge {
  position: absolute;
  z-index: 6;
  right: 0;
  top: 0;
  padding: 5rpx 15rpx;
  border-radius: 0 17rpx 0 12rpx;
  background: #e3edff;
  color: #5b8fd9;
  font-size: 19rpx;
  line-height: 27rpx;
}

.thesis-actions {
  position: absolute;
  left: 21rpx;
  bottom: 13rpx;
  z-index: 4;
  width: 444rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.thesis-action {
  flex: none;
  width: 132rpx;
  border-radius: 12rpx;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.thesis-action-icon {
  flex: none;
  width: 46rpx;
  height: 46rpx;
  margin-right: 8rpx;
}

.thesis-action-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.thesis-action-name {
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 600;
  color: #191919;
  white-space: nowrap;
}

.thesis-action-desc {
  font-size: 17rpx;
  line-height: 22rpx;
  color: #858b8f;
  white-space: nowrap;
}

.thesis-art {
  position: absolute;
  z-index: 2;
  right: 8rpx;
  bottom: 4rpx;
  width: 133rpx;
  height: 104rpx;
}

.recommend-section {
  width: 645rpx;
  margin-top: 16rpx;
}

.recommend-header {
  width: 645rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recommend-heading {
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 600;
  color: #111111;
}

.refresh-entry {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  line-height: 28rpx;
  color: #969a9e;
}

.refresh-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 5rpx;
}

.recommend-grid {
  width: 645rpx;
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: 204rpx 204rpx 200rpx;
  column-gap: 18rpx;
  align-items: stretch;
}

.recommend-card,
.recommend-ad-card {
  position: relative;
  width: 100%;
  height: 288rpx;
  min-width: 0;
  overflow: hidden;
  border-radius: 15rpx;
}

.recommend-card {
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(25, 45, 66, 0.07);
}

/* 加载态：与卡片同尺寸，避免布局跳动 */
.recommend-skeleton {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 260rpx;
  color: #99a3ad;
  font-size: 22rpx;
}

.recommend-image-wrap {
  position: relative;
  width: 100%;
  height: 136rpx;
  overflow: hidden;
}

.recommend-image {
  display: block;
  width: 100%;
  height: 100%;
}

.recommend-tag {
  position: absolute;
  left: 10rpx;
  bottom: 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #55c888;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 24rpx;
}

.recommend-title {
  margin: 9rpx 10rpx 0;
  font-size: 22rpx;
  line-height: 29rpx;
  font-weight: 600;
  color: #171717;
}

.recommend-line {
  display: block;
  white-space: nowrap;
}

.recommend-meta {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 9rpx;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 18rpx;
  line-height: 23rpx;
  color: #989da1;
  white-space: nowrap;
}

.meta-side {
  min-width: 0;
  display: flex;
  align-items: center;
}

.meta-side:first-child text {
  max-width: 78rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.meta-icon {
  flex: none;
  width: 19rpx;
  height: 19rpx;
  margin-right: 3rpx;
}

.fire-icon {
  width: 20rpx;
  height: 20rpx;
}

.meta-hot {
  margin-left: 3rpx;
  color: #63686d;
}

.recommend-ad-card {
  padding: 16rpx 13rpx;
  background: #dfeefc;
}

.ad-title,
.ad-highlight,
.ad-desc,
.ad-button {
  position: relative;
  z-index: 4;
  display: block;
}

.ad-title {
  font-size: 26rpx;
  line-height: 33rpx;
  font-weight: 600;
  color: #15191d;
}

.ad-highlight {
  margin-top: 2rpx;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 600;
  color: #3476f6;
  white-space: nowrap;
}

.ad-desc {
  width: 150rpx;
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 24rpx;
  color: #8295a6;
}

.ad-button {
  width: 110rpx;
  margin-top: 11rpx;
  padding: 6rpx 6rpx;
  border-radius: 18rpx;
  background: #3476f6;
  color: #ffffff;
  font-size: 19rpx;
  line-height: 24rpx;
  text-align: center;
  white-space: nowrap;
}

.ad-laptop {
  position: absolute;
  z-index: 2;
  right: -5rpx;
  bottom: 15rpx;
  width: 140rpx;
  height: 96rpx;
}

.ad-badge {
  position: absolute;
  z-index: 6;
  right: 5rpx;
  bottom: 5rpx;
  padding: 3rpx 8rpx;
  border-radius: 5rpx;
  background: rgba(81, 91, 100, 0.65);
  color: #ffffff;
  font-size: 17rpx;
  line-height: 22rpx;
}

.bottom-tabbar {
  position: fixed;
  z-index: 50;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #ededed;
}

.tabbar-content {
  height: 106rpx;
  display: flex;
  align-items: stretch;
}

.safe-area {
  height: env(safe-area-inset-bottom);
}

.tab-item {
  position: relative;
  width: 20%;
  height: 106rpx;
  padding-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #3f4449;
}

.tab-item.active {
  color: #346ff9;
}

.tab-icon-wrap {
  position: relative;
  width: 35rpx;
  height: 35rpx;
}

.tab-icon {
  width: 34rpx;
  height: 34rpx;
}

.message-icon {
  width: 35rpx;
  height: 35rpx;
}

.message-dot {
  position: absolute;
  right: -4rpx;
  top: -3rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ff5b52;
  border: 2rpx solid #ffffff;
}

.tab-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 27rpx;
  font-weight: 400;
}

.active .tab-label {
  font-weight: 500;
}

.publish-item {
  padding-top: 0;
}

.publish-button {
  width: 62rpx;
  height: 62rpx;
  margin-top: -24rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #3476f6;
  box-shadow: 0 5rpx 12rpx rgba(52, 118, 246, 0.25);
}

.publish-plus {
  width: 33rpx;
  height: 33rpx;
}

.publish-label {
  margin-top: 8rpx;
}

/* 学校 logo：管理端填了才显示 */
.school-logo{width:34rpx;height:34rpx;border-radius:50%;margin-right:10rpx;flex-shrink:0;background:#eef1f4}

/* AI 校园助手入口：导航栏右侧小按钮 */
.ai-entry{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;margin-right:8rpx;border-radius:50%;background:#eef4ff;flex-shrink:0}
.ai-entry:active{background:#dde8ff}
.ai-entry-icon{font-size:30rpx;color:#3476f6;line-height:1}
