.bubble {
  position: relative;
  display: inline-block;
  max-width: 100%;
  padding: 18rpx 26rpx;
  background: var(--c-card);
  border: var(--bw) solid var(--c-line);
  border-radius: 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(32, 61, 52, 0.06);
  animation: bubble-in 220ms ease-out;
}

.bubble-text {
  font-size: var(--fs-body);
  color: var(--c-text);
  line-height: 1.55;
  word-break: break-word;
}

/* 小尾巴指向宠物 */
.bubble-tail {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 20rpx;
  height: 20rpx;
  margin-left: -10rpx;
  background: var(--c-card);
  border-right: var(--bw) solid var(--c-line);
  border-bottom: var(--bw) solid var(--c-line);
  transform: rotate(45deg);
  border-bottom-right-radius: 4rpx;
}

.bubble--out {
  animation: bubble-out 180ms ease-in forwards;
}

@keyframes bubble-in {
  from { opacity: 0; transform: translateY(10rpx) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes bubble-out {
  from { opacity: 1; }
  to   { opacity: 0; transform: translateY(-6rpx); }
}

@media (prefers-reduced-motion: reduce) {
  .bubble, .bubble--out { animation: none; }
}
