<!-- pet-float：全局悬浮宠物
     两种渲染模式，交互完全一致（可拖动、轻点冒泡、位置跨页保留）：
       默认（Canvas）——首页/发现/宠物相关页，带呼吸动画
       static        ——其余页面，用静态首帧图，省掉 Canvas 初始化 + 6 张图加载 -->
<movable-area class="pf-area" style="height:{{areaHeight}}px;">
  <movable-view hover-class="tap" hover-stay-time="80"
    class="pf-view"
    direction="all"
    inertia="{{false}}"
    x="{{x}}"
    y="{{y}}"
    damping="{{100}}"
    friction="{{2}}"
    out-of-bounds="{{false}}"
    bindchange="onDragChange"
    bindtouchend="onDragEnd"
    bindtap="onTap"
  >
    <view class="pf-ball">
      <view class="pf-pet">
        <image
          wx:if="{{static}}"
          class="pf-static"
          src="{{staticSrc}}"
          mode="aspectFit"
        />
        <pet-avatar
          wx:else
          size="{{60}}"
          auto="{{!reduceMotion}}"
          paused="{{dragging}}"
        />
      </view>
    </view>
    <view class="pf-badge" wx:if="{{hasNews}}"></view>
  </movable-view>
</movable-area>

<!-- 气泡：跟随宠物位置 -->
<view
  class="pf-bubble"
  style="left:{{bubbleLeft}}px;top:{{bubbleTop}}px;"
  wx:if="{{bubbleText}}"
>
  <text class="pf-bubble-text">{{bubbleText}}</text>
</view>
