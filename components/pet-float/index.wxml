<!-- pet-float：全局悬浮宠物
     全屏可拖动：小猫跟着手指走（无阴影跟随，避免拖出拖影）
     松手后记住位置，切页面也保留；轻点冒泡，拖动时不误触 -->
<movable-area class="pf-area" style="height:{{areaHeight}}px;">
  <movable-view
    class="pf-view"
    direction="all"
    inertia="{{false}}"
    x="{{x}}"
    y="{{y}}"
    damping="{{30}}"
    friction="{{2}}"
    out-of-bounds="{{false}}"
    bindchange="onDragChange"
    bindtouchend="onDragEnd"
    bindtap="onTap"
  >
    <view class="pf-ball">
      <view class="pf-pet {{dragging ? 'pf-pet--dragging' : ''}}">
        <pet-avatar
          appearance="{{appearance}}"
          size="{{60}}"
          auto="{{!reduceMotion}}"
          paused="{{dragging}}"
        />
      </view>
    </view>
    <view class="pf-badge" wx:if="{{hasNews}}"></view>
  </movable-view>
</movable-area>

<!-- 气泡：跟随宠物位置 -->
<view
  class="pf-bubble"
  style="left:{{bubbleLeft}}px;top:{{bubbleTop}}px;"
  wx:if="{{bubbleText}}"
>
  <text class="pf-bubble-text">{{bubbleText}}</text>
</view>
