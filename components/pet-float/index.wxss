/* pet-float：可拖动的全局悬浮宠物 */

/* 拖动区域铺满视口，但本身不拦截事件（pointer-events: none）
   只有宠物本体（movable-view）可点可拖 */
.pf-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 90;
  pointer-events: none;
  background: transparent;
}

/* 可拖动的小球 */
.pf-view {
  width: 136rpx;
  height: 136rpx;
  /* 只有它接收事件 */
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 提升合成层，拖动更顺滑 */
  will-change: transform;
  transform: translateZ(0);
}

/* 容器：透明，宠物直接浮在页面上
   注意：这里绝对不能对 transform 做动画——movable-view 拖动时
   依赖 transform 定位，两处同时改 transform 会互相覆盖导致卡顿 */
.pf-ball {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  background: transparent;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: visible;
}

/* 脚下投影：静态，承担全部轮廓/落地感（不用 filter，拖动零开销） */
.pf-shadow {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  width: 72rpx;
  height: 16rpx;
  margin-left: -36rpx;
  border-radius: 50%;
  background: rgba(32, 61, 52, 0.22);
  box-shadow: 0 0 16rpx 10rpx rgba(32, 61, 52, 0.16);
  z-index: 0;
}

/* 宠物本体：单层投影（三层 filter 在拖动时太重） */
.pf-pet {
  position: relative;
  z-index: 1;
  /* 不用 filter: drop-shadow —— 它要按图形轮廓逐帧重算，拖动时开销很高。
     轮廓感改由下方 .pf-shadow 的静态投影提供 */
}

/* 红点 */
.pf-badge {
  position: absolute;
  right: 8rpx;
  top: 10rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--c-accent, #BD5134);
  box-shadow: 0 2rpx 6rpx rgba(189, 81, 52, 0.35);
  z-index: 2;
}

/* 气泡：跟随宠物位置（left/top 由 JS 计算） */
.pf-bubble {
  position: fixed;
  max-width: 300rpx;
  padding: 14rpx 22rpx;
  background: var(--c-card, #FFFCF5);
  border: 1rpx solid var(--c-line, #DEDCCD);
  border-radius: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(32, 61, 52, 0.12);
  z-index: 91;
  pointer-events: none;
}

.pf-bubble-text {
  font-size: 24rpx;
  color: var(--c-text, #203D34);
  line-height: 1.5;
}
