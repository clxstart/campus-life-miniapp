/* pet-float：可拖动的全局悬浮宠物 */

/* 拖动区域铺满视口，但本身不拦截事件（pointer-events: none）
   只有宠物本体（movable-view）可点可拖 */
.pf-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 90;
  pointer-events: none;
  background: transparent;
}

/* 可拖动的小球 */
.pf-view {
  width: 136rpx;
  height: 136rpx;
  /* 只有它接收事件 */
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 容器：透明，宠物直接浮在页面上 */
.pf-ball {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  background: transparent;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: visible;
  animation: pf-breathe 3.4s ease-in-out infinite;
}

/* 脚下投影 */
.pf-shadow {
  position: absolute;
  left: 50%;
  bottom: -6rpx;
  width: 64rpx;
  height: 14rpx;
  margin-left: -32rpx;
  border-radius: 50%;
  background: rgba(32, 61, 52, 0.22);
  box-shadow: 0 0 14rpx 8rpx rgba(32, 61, 52, 0.16);
  z-index: 0;
  animation: pf-shadow 3.4s ease-in-out infinite;
}

@keyframes pf-shadow {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%      { transform: scale(0.85); opacity: 0.65; }
}

/* 宠物本体：投影衬托轮廓，不用白圈 */
.pf-pet {
  position: relative;
  z-index: 1;
  filter:
    drop-shadow(0 0 2rpx rgba(32, 61, 52, 0.30))
    drop-shadow(0 4rpx 6rpx rgba(32, 61, 52, 0.26))
    drop-shadow(0 10rpx 18rpx rgba(32, 61, 52, 0.18));
}

/* 呼吸：轻微上浮 */
@keyframes pf-breathe {
  0%, 100% { transform: scale(1) translateY(0); }
  50%      { transform: scale(1.04) translateY(-6rpx); }
}

/* 红点 */
.pf-badge {
  position: absolute;
  right: 8rpx;
  top: 10rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--c-accent, #BD5134);
  box-shadow: 0 2rpx 6rpx rgba(189, 81, 52, 0.35);
  z-index: 2;
}

/* 气泡：跟随宠物位置（left/top 由 JS 计算） */
.pf-bubble {
  position: fixed;
  max-width: 300rpx;
  padding: 14rpx 22rpx;
  background: var(--c-card, #FFFCF5);
  border: 1rpx solid var(--c-line, #DEDCCD);
  border-radius: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(32, 61, 52, 0.12);
  z-index: 91;
  pointer-events: none;
}

.pf-bubble-text {
  font-size: 24rpx;
  color: var(--c-text, #203D34);
  line-height: 1.5;
}

@media (prefers-reduced-motion: reduce) {
  .pf-ball, .pf-shadow { animation: none; }
}
