<!-- wardrobe-item：装扮物品卡片，三态明确区分 -->
<view class="witem {{item.state === 'equipped' ? 'witem--equipped' : ''}}">
  <view class="witem-thumb">
    <pet-avatar appearance="{{previewAppearance}}" size="{{72}}" crop="{{false}}" />
  </view>

  <view class="witem-body">
    <view class="witem-head">
      <text class="witem-name">{{item.name}}</text>
      <!-- 状态标签：文字表达，不只靠颜色 -->
      <text class="witem-state witem-state--{{item.state}}">{{stateLabel}}</text>
    </view>
    <text class="witem-desc cp-hint">{{item.description}}</text>
    <view class="witem-price" wx:if="{{item.state === 'locked'}}">
      <text class="witem-price-num">{{item.price}}</text>
      <text class="witem-price-unit">积分</text>
    </view>
  </view>

  <view class="witem-action">
    <button
      wx:if="{{item.state === 'locked'}}"
      class="mini-btn mini-btn--primary"
      catchtap="onBuy"
    >兑换</button>
    <button
      wx:elif="{{item.state === 'owned'}}"
      class="mini-btn mini-btn--ghost"
      catchtap="onEquip"
    >装备</button>
    <button
      wx:else
      class="mini-btn mini-btn--flat"
      catchtap="onUnequip"
    >已装备</button>
  </view>
</view>
