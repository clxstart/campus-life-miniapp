<!-- appearance-editor：捏脸选项面板 -->
<view class="editor">
  <!-- 分类：TDesign Tabs -->
  <t-tabs
    value="{{activeTab}}"
    theme="tag"
    space-evenly="{{false}}"
    bind:change="onTabChange"
  >
    <t-tab-panel
      wx:for="{{categories}}"
      wx:key="key"
      label="{{item.name}}"
      value="{{item.key}}"
    ></t-tab-panel>
  </t-tabs>

  <!-- 选项区 -->
  <scroll-view scroll-y class="editor-options" enhanced show-scrollbar="{{false}}">
    <view class="opt-grid">
      <view
        wx:for="{{currentOptions}}"
        wx:key="id"
        class="opt {{appearance[activeTab] === item.id ? 'cp-selected' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPick"
      >
        <!-- 每个选项都渲染真实预览：用同一套外观组合，只替换当前这一项 -->
        <pet-avatar
          appearance="{{item.preview}}"
          size="{{64}}"
          crop="{{false}}"
        />
        <text class="opt-name">{{item.name}}</text>
        <text class="opt-check" wx:if="{{appearance[activeTab] === item.id}}">✓</text>
      </view>
    </view>
  </scroll-view>
</view>
