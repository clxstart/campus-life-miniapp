:host {
  display: block;
}

.bottom-nav {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eceff3;
  box-shadow: 0 -5rpx 18rpx rgba(30, 48, 70, 0.035);
}

.nav-row {
  height: 100rpx;
  display: flex;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}

.nav-item {
  position: relative;
  width: 20%;
  padding-top: 21rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #4c5258;
  font-size: 18rpx;
  line-height: 24rpx;
}

.nav-item.active,
.active-text {
  color: #346ff9;
  font-weight: 500;
}

.nav-icon,
.icon-wrap {
  width: 29rpx;
  height: 29rpx;
}

.icon-wrap {
  position: relative;
}

.message-icon {
  width: 30rpx;
  height: 30rpx;
}

/* 组件 wxss 不允许标签选择器，因此文字用类选择器 */
.nav-label {
  margin-top: 5rpx;
}

.unread-dot {
  position: absolute;
  top: -3rpx;
  right: -5rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ff5b52;
  border: 2rpx solid #ffffff;
}

.publish {
  padding-top: 0;
}

.publish-circle {
  width: 58rpx;
  height: 58rpx;
  margin-top: -22rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #4791ff, #2e6df5);
  box-shadow: 0 7rpx 15rpx rgba(52, 111, 249, 0.26);
}

/* 组件 wxss 不允许标签选择器，改用类选择器 */
.publish-plus {
  width: 29rpx;
  height: 29rpx;
}

.publish-text {
  margin-top: 8rpx !important;
}
