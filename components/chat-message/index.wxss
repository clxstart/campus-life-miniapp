.msg {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
}

/* 用户消息靠右 */
.msg--user {
  flex-direction: row-reverse;
}

.msg-avatar {
  flex-shrink: 0;
  margin-top: 6rpx;
}

.msg-main {
  max-width: 78%;
  min-width: 0;
}

.msg--user .msg-main {
  align-items: flex-end;
  display: flex;
  flex-direction: column;
}

.msg-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.msg-name {
  font-size: 24rpx;
  color: var(--c-text-sub);
}

/* AI 身份标识：明确告诉用户对面是模型 */
.msg-badge {
  font-size: 18rpx;
  padding: 1rpx 8rpx;
  border-radius: 6rpx;
  background: var(--c-soft);
  color: var(--c-primary);
  line-height: 1.7;
}

/* 气泡：宠物=卡片底色，用户=浅绿；高度自适应，正文换行 */
.msg-bubble {
  display: inline-block;
  max-width: 100%;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: var(--c-card);
  border: var(--bw) solid var(--c-line);
  box-sizing: border-box;
}

.msg--user .msg-bubble {
  background: var(--c-soft);
  border-color: transparent;
}

.msg-text {
  font-size: var(--fs-body);
  line-height: 1.65;
  color: var(--c-text);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 发送中三点动画 */
.msg-typing {
  display: inline-flex;
  gap: 6rpx;
  margin-left: 8rpx;
  vertical-align: middle;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--c-text-sub);
  animation: dot-blink 1.1s infinite ease-in-out;
}

.dot:nth-child(2) { animation-delay: 0.16s; }
.dot:nth-child(3) { animation-delay: 0.32s; }

@keyframes dot-blink {
  0%, 80%, 100% { opacity: 0.25; }
  40% { opacity: 1; }
}

/* 失败提示 */
.msg-fail {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.msg-fail-text {
  font-size: var(--fs-hint);
  color: var(--c-accent);
}

.msg-retry {
  font-size: var(--fs-hint);
  color: var(--c-primary);
  text-decoration: underline;
  padding: 4rpx 8rpx;
}

/* Mock 演示态：明确标注，不伪装成真实结果 */
.msg-mock {
  margin-top: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  background: #F4EFE2;
  display: inline-block;
}

.msg-mock-text {
  font-size: 20rpx;
  color: var(--c-text-sub);
}

@media (prefers-reduced-motion: reduce) {
  .dot { animation: none; opacity: 0.6; }
}
