<!-- 轻提示 -->
<view class="ui-popup-mask toast-mask {{visible && mode === 'toast' ? 'show' : ''}}" bindtap="close" catchtouchmove="noop">
  <view hover-class="tap" hover-stay-time="80" class="ui-toast {{visible && mode === 'toast' ? 'show' : ''}}" catchtap="noop">
    <view class="toast-icon" wx:if="{{showIcon}}" style="background: {{toneColor}}">{{iconChar}}</view>
    <text class="toast-text">{{message || title}}</text>
  </view>
</view>

<!-- 对话框 -->
<view class="ui-popup-mask {{visible && mode === 'modal' ? 'show' : ''}}" bindtap="close" catchtouchmove="noop">
  <view hover-class="tap" hover-stay-time="80" class="ui-modal {{visible && mode === 'modal' ? 'show' : ''}}" catchtap="noop">
    <view class="modal-icon" style="background: {{toneColor}}">{{iconChar}}</view>
    <text class="modal-title" wx:if="{{title}}">{{title}}</text>
    <text class="modal-message" wx:if="{{message}}">{{message}}</text>
    <input
      wx:if="{{editable}}"
      class="modal-input"
      value="{{inputValue}}"
      placeholder="{{placeholder}}"
      bindinput="onInput"
    />
    <view class="modal-buttons">
      <view hover-class="tap-btn" hover-stay-time="80" wx:if="{{showCancel}}" class="modal-button cancel" bindtap="onCancel">{{cancelText}}</view>
      <view hover-class="tap-btn" hover-stay-time="80" class="modal-button confirm" style="background: {{toneColor}}" bindtap="onConfirm">{{confirmText}}</view>
    </view>
  </view>
</view>

<!-- 底部操作列表 -->
<view class="ui-popup-mask sheet-mask {{visible && mode === 'sheet' ? 'show' : ''}}" bindtap="close" catchtouchmove="noop">
  <view hover-class="tap" hover-stay-time="80" class="ui-sheet {{visible && mode === 'sheet' ? 'show' : ''}}" catchtap="noop">
    <view class="sheet-title" wx:if="{{title}}">{{title}}</view>
    <view hover-class="tap-card" hover-stay-time="80"
      wx:for="{{actions}}"
      wx:key="label"
      class="sheet-item"
      style="color: {{toneColor}}"
      data-index="{{index}}"
      bindtap="onAction"
    >{{item.label}}</view>
    <view hover-class="tap" hover-stay-time="80" class="sheet-cancel" bindtap="onCancel">取消</view>
  </view>
</view>
