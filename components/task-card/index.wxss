.tc {
  background: var(--c-card);
  border: var(--bw) solid var(--c-line);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.tc + .tc {
  margin-top: var(--sp-gap);
}

.tc--running {
  border-color: var(--c-primary);
}

.tc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: var(--sp-card);
}

.tc-title-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.tc-title {
  font-size: var(--fs-card-title);
  font-weight: 600;
  color: var(--c-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tc-status {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  line-height: 1.7;
}

.tc-status--idle { background: #F0EDE3; color: var(--c-text-sub); }
.tc-status--running { background: var(--c-soft); color: var(--c-primary); }
.tc-status--claimable { background: var(--c-accent); color: #FFF; }
.tc-status--claimed { background: #EDEAE0; color: var(--c-text-sub); }

.tc-caret {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--c-bg);
  color: var(--c-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.tc-body {
  padding: 0 var(--sp-card) var(--sp-card);
  border-top: var(--bw) solid var(--c-line);
  padding-top: 18rpx;
}

.tc-desc {
  display: block;
  font-size: var(--fs-body);
  color: var(--c-text-sub);
  line-height: 1.6;
}

.tc-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-col);
  margin-top: 18rpx;
}

.tc-meta-item {
  background: var(--c-bg);
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
}

.tc-meta-label {
  display: block;
  font-size: 20rpx;
  color: var(--c-text-sub);
}

.tc-meta-value {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text);
}

.tc-running {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: var(--c-soft);
  border-radius: 16rpx;
}

.tc-running-text {
  font-size: var(--fs-hint);
  color: var(--c-primary);
}

.tc-action {
  margin-top: 20rpx;
}

.tc-btn {
  height: var(--h-button);
  line-height: var(--h-button);
  border-radius: var(--radius-pill);
  font-size: var(--fs-body);
  font-weight: 600;
  margin: 0;
}

.tc-btn--primary {
  background: var(--c-primary);
  color: var(--c-on-primary);
}

.tc-btn--flat {
  background: #EDEAE0;
  color: var(--c-text-sub);
}

.tc-btn[disabled] {
  opacity: 0.7;
}
