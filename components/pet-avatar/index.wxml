<view class="pet-wrap" aria-label="{{label}}">
  <canvas id="petCanvas" type="2d" class="pet-canvas" bindtap="onTap" />
  <view wx:if="{{!ready && !error}}" class="pet-loading">小橘正在赶来…</view>
  <view wx:if="{{error}}" class="pet-loading"><text>{{error}}</text><button bindtap="retry" size="mini">重新加载</button></view>
</view>
