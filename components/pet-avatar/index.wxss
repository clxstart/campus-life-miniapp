/* pet-avatar：宠物头像容器
   注意：不能写死 min-height——调用方通过 size 指定像素尺寸时，
   写死的最小高度会让内部元素比容器大，导致溢出/裁切。 */

:host {
  display: block;
  width: 100%;
  height: 100%;
}

.pet-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  display: block;
}

.pet-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

/* 加载中 / 错误提示 */
.pet-loading {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
  justify-content: center;
  color: #866852;
  font-size: 24rpx;
  text-align: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}
