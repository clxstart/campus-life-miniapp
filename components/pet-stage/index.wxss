.stage {
  position: relative;
  width: 100%;
  height: 560rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  background: linear-gradient(
    180deg,
    var(--c-bg) 0%,
    var(--c-bg) 18%,
    var(--c-soft) 18%,
    var(--c-soft) 62%,
    #EFE1C6 62%,
    #F1E6D0 100%
  );
}

.stage--compact {
  height: 380rpx;
}

/* ===== 远景 ===== */
.stage-sky {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 62%;
  pointer-events: none;
  overflow: hidden;
}

.stage-cloud {
  position: absolute;
  background: #fff;
  border-radius: 999rpx;
  opacity: 0.55;
}

.stage-cloud--a {
  width: 120rpx;
  height: 44rpx;
  left: 12%;
  top: 22%;
}

.stage-cloud--b {
  width: 88rpx;
  height: 34rpx;
  right: 16%;
  top: 14%;
  opacity: 0.42;
}

/* 小树/灌木：柔和色块，不抢宠物 */
.stage-tree {
  position: absolute;
  background: #CADCC2;
  border-radius: 50% 50% 42% 42%;
  bottom: 4%;
}

.stage-tree--l {
  width: 130rpx;
  height: 100rpx;
  left: -24rpx;
}

.stage-tree--r {
  width: 96rpx;
  height: 76rpx;
  right: 8rpx;
  opacity: 0.85;
}

/* ===== 地面阴影线 ===== */
.stage-ground {
  position: absolute;
  left: 0;
  right: 0;
  top: 61%;
  height: 3rpx;
  background: rgba(222, 220, 205, 0.6);
}

/* ===== 宠物 ===== */
.stage-pet {
  position: absolute;
  left: 50%;
  bottom: 14rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 气泡位 */
.stage-bubble {
  position: absolute;
  left: 50%;
  top: 22rpx;
  transform: translateX(-50%);
  max-width: 88%;
  z-index: 2;
}
