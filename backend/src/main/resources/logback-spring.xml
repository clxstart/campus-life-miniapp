<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置：控制台 + 文件双输出，按天+大小轮转，保留 30 天。

  为什么要这个文件：之前没有它，Spring 默认只往控制台打日志，进程重启/工具关掉就全没了，
  出了问题完全无法回溯。这里把日志落到 logs/ 下，并用 %X{traceId} 把一次请求的多行日志串起来。

  traceId 由 RequestTraceFilter 写入 MDC，响应头 X-Request-Id 也会带回同一个值，
  所以用户报障时报一个 id，就能 grep 出这一次请求的全部日志。
-->
<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="PATTERN_CONSOLE"
              value="%d{HH:mm:ss.SSS} [%X{traceId:--}] %-5level %logger{32} - %msg%n"/>
    <property name="PATTERN_FILE"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{traceId:--}] %-5level [%thread] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN_CONSOLE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 全量日志：按天 + 100MB 切分，保留 30 天，旧的自动 gz 压缩 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 只收 WARN 及以上：排障先看这个文件，噪音少 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 第三方库降噪：MyBatis 的 SQL 明细只在 dev 开，生产不刷屏 -->
    <logger name="com.campuslife.mapper" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
