# 环境变量配置模板
#
# 用法：
#   1. 复制本文件为 .env.local（该文件已被 .gitignore 忽略，不会进仓库）
#   2. 把等号后面的值换成真实值
#   3. 启动后端前加载这些变量（见文末「加载方式」）
#
# ⚠️ 重要：不要把填了真实值的 .env.local 提交到 Git

# ============================================================
# 一、数据库
# ============================================================

# 本地开发（默认值，可留空）
DB_URL=jdbc:mysql://127.0.0.1:3306/campus_life?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false
DB_USERNAME=root
DB_PASSWORD=chang090011

# 生产环境示例（云数据库或独立数据库服务器）
# DB_URL=jdbc:mysql://your-db-host:3306/campus_life?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=true
# DB_USERNAME=campus_user
# DB_PASSWORD=<强密码>

# ============================================================
# 二、小程序 AppID
# ============================================================
# 从 mp.weixin.qq.com 后台「开发管理 → 开发设置」获取
# 拿到后还需要改 project.config.json 里的 appid 字段
CAMPUS_WX_APPID=
CAMPUS_WX_SECRET=

# ============================================================
# 三、微信支付
# ============================================================
# 未开通支付时保持 false，走模拟支付
WXPAY_ENABLED=false

# 以下 5 项在微信支付商户平台（pay.weixin.qq.com）获取
# 路径：账户中心 → API 安全
WXPAY_APP_ID=
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_CERT_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=

# 回调地址：必须是公网可访问的 HTTPS 地址
# 部署后改成：https://your-domain.com/api/pay/notify
WXPAY_NOTIFY_URL=https://your-domain.example/api/pay/notify
WXPAY_REFUND_NOTIFY_URL=https://your-domain.example/api/pay/refund/notify

# ============================================================
# 四、安全与跨域
# ============================================================

# 生产环境必须为 true（否则任何人可冒充任意用户）
CAMPUS_AUTH_ENFORCE=true

# 开发登录：只允许登录 1 号账号，生产环境即使设 true 也无效
CAMPUS_DEV_LOGIN_ANY_USER=false

# 管理端跨域白名单，生产环境换成自己的前端域名
# 本地开发：http://127.0.0.1:*,http://localhost:*
# 生产环境：https://admin.your-domain.com
CAMPUS_WEB_ORIGINS=http://127.0.0.1:*,http://localhost:*

# ============================================================
# 五、文件上传
# ============================================================

# 上传文件存储目录
CAMPUS_UPLOAD_DIR=uploads

# 上传文件的公网访问基址
# 本地：http://127.0.0.1:8080
# 生产：https://your-domain.com
CAMPUS_UPLOAD_BASE_URL=http://127.0.0.1:8080

# ============================================================
# 六、模拟支付（仅本地演示）
# ============================================================
# 生产环境请设为 false
CAMPUS_PAY_SIMULATE=true

# ============================================================
# 加载方式
# ============================================================
#
# 【Windows PowerShell】
#   Get-Content .env.local | ForEach-Object {
#     if ($_ -match '^([^#][^=]*)=(.*)$') {
#       [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process')
#     }
#   }
#   java -jar campus-life-api.jar
#
# 【Linux / macOS】
#   set -a; source .env.local; set +a
#   java -jar campus-life-api.jar
#
# 【Docker】
#   docker run --env-file .env.local your-image
