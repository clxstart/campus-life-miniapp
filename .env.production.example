# 生产环境变量模板。复制为 /opt/campus/.env.production，不要提交真实值。
#
# 启动前必须：
#   1. 执行 docs/部署与上线指南.md 里的数据库迁移和演示账号清理；
#   2. 以 --spring.profiles.active=prod 启动；
#   3. 确认本文件没有任何 <...> 占位值残留。
#
# 生产 profile 启动校验会在下列任一不安全时直接失败，不会带病启动。

# ============================================================
# 一、数据库
# ============================================================
DB_URL=jdbc:mysql://<生产数据库主机>:3306/campus_life?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=true
DB_USERNAME=<非 root 数据库账号>
DB_PASSWORD=<强随机密码>

# ============================================================
# 二、小程序登录
# ============================================================
CAMPUS_WX_APPID=<正式小程序 AppID，不能是 touristappid>
CAMPUS_WX_SECRET=<正式小程序 Secret>

# ============================================================
# 三、安全与跨域
# ============================================================
CAMPUS_AUTH_ENFORCE=true
CAMPUS_DEV_LOGIN_ENABLED=false
CAMPUS_DEV_LOGIN_ANY_USER=false
# 至少 32 位随机值，例如 openssl rand -base64 48
CAMPUS_JWT_SECRET=<至少 32 位随机密钥>
CAMPUS_WEB_ORIGINS=https://<管理端真实域名>

# ============================================================
# 四、部署形态
# ============================================================
# single = 单实例；cluster = 多实例（必须同时配 Redis + 对象存储）
CAMPUS_HA_MODE=single
CAMPUS_HA_NODE_ID=

# cluster 模式才需要：
# CAMPUS_HA_REDIS_URL=redis://:<密码>@<Redis 主机>:6379/0
# CAMPUS_HA_RATE_LIMIT_FAIL_OPEN=false
# CAMPUS_HA_STORAGE_TYPE=s3
# CAMPUS_HA_STORAGE_ENDPOINT=https://<对象存储 Endpoint>
# CAMPUS_HA_STORAGE_REGION=<Region>
# CAMPUS_HA_STORAGE_BUCKET=<Bucket>
# CAMPUS_HA_STORAGE_ACCESS_KEY=<AccessKey>
# CAMPUS_HA_STORAGE_SECRET_KEY=<SecretKey>
# CAMPUS_HA_STORAGE_PUBLIC_BASE_URL=https://<CDN 或对象存储公网域名>

# ============================================================
# 五、文件上传
# ============================================================
CAMPUS_UPLOAD_DIR=/opt/campus/uploads
CAMPUS_UPLOAD_BASE_URL=https://<API 或 CDN 真实域名>

# ============================================================
# 六、支付与业务开关
# ============================================================
CAMPUS_PAY_SIMULATE=false

# 不接支付保持 false；接支付时以下全部必填
WXPAY_ENABLED=false
# WXPAY_APP_ID=<必须与 CAMPUS_WX_APPID 一致>
# WXPAY_MCH_ID=<商户号>
# WXPAY_API_V3_KEY=<32 位 APIv3 密钥>
# WXPAY_CERT_SERIAL_NO=<证书序列号>
# WXPAY_PRIVATE_KEY_PATH=/opt/campus/certs/apiclient_key.pem
# WXPAY_NOTIFY_URL=https://<API 域名>/api/pay/notify
# WXPAY_REFUND_NOTIFY_URL=https://<API 域名>/api/pay/refund/notify

# ============================================================
# 启动方式（示例）
# ============================================================
# set -a; source /opt/campus/.env.production; set +a
# java -jar campus-life-api.jar --spring.profiles.active=prod